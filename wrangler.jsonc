{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flavia-site-novo",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{ "pattern": "flaviajackeline.com", "custom_domain": true },
		{ "pattern": "www.flaviajackeline.com", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "flavia-site-db",
			"database_id": "f9d041d4-1f4d-4650-b28d-71f022d5e413"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "flavia-site-media"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "23de1164b5554493ba3a5f8a92f472d7"
		}
	]
}
