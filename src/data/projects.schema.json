{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://flaviajackeline.com/schemas/project.json",
	"title": "Project",
	"description": "A single portfolio project. One row of a future `projects` table.",
	"type": "object",
	"required": [
		"id",
		"slug",
		"client",
		"country",
		"segment",
		"year",
		"category",
		"tags",
		"shortDescription",
		"description",
		"images",
		"thumbnail"
	],
	"additionalProperties": false,
	"properties": {
		"id": {
			"type": "string",
			"description": "Stable unique identifier (future primary key). Never reused or changed.",
			"pattern": "^[a-z0-9-]+$"
		},
		"slug": {
			"type": "string",
			"description": "URL segment: /portfolio/<slug>. Unique.",
			"pattern": "^[a-z0-9-]+$"
		},
		"client": {
			"type": "string",
			"description": "Client / brand name."
		},
		"country": {
			"type": "string",
			"description": "Client country, plain name (e.g. \"Brazil\", \"United States\")."
		},
		"segment": {
			"type": "string",
			"description": "Client market segment / industry (e.g. \"Hospitality\", \"Fashion\")."
		},
		"year": {
			"type": "integer",
			"description": "Year the project was delivered.",
			"minimum": 2000,
			"maximum": 2100
		},
		"category": {
			"type": "string",
			"description": "Primary deliverable category (e.g. \"Brand Identity\", \"Art Direction\")."
		},
		"tags": {
			"type": "array",
			"description": "Free-form keywords for filtering.",
			"items": { "type": "string" },
			"uniqueItems": true
		},
		"shortDescription": {
			"type": "string",
			"description": "Short lead-in summary of the project, shown as a headline above the full description."
		},
		"description": {
			"type": "array",
			"description": "Ordered rich-text blocks, like the output of a block editor. Each block is one element; render `type` as the HTML tag and `text` as its content.",
			"items": {
				"type": "object",
				"required": ["type", "text"],
				"additionalProperties": false,
				"properties": {
					"type": {
						"type": "string",
						"description": "Block element to render.",
						"enum": ["h1", "h2", "h3", "h4", "h5", "h6", "p"]
					},
					"text": {
						"type": "string",
						"description": "Content of the block. May contain inline rich-text formatting produced by the admin editor: <b>/<strong>, <i>/<em>, <u>, <a href>, <br>. No other tags are allowed — sanitized server-side on save."
					}
				}
			}
		},
		"images": {
			"type": "array",
			"description": "Ordered gallery images.",
			"items": {
				"type": "object",
				"required": ["url", "alt"],
				"additionalProperties": false,
				"properties": {
					"url": {
						"type": "string",
						"description": "Path (from /public) or absolute URL."
					},
					"alt": {
						"type": "string",
						"description": "Alt text. Falls back to a title derived from the file name when left empty by the admin."
					}
				}
			}
		},
		"thumbnail": {
			"type": "string",
			"description": "Display image for listings: a still image or an animated GIF. Path from /public or absolute URL."
		}
	},
	"examples": [
		{
			"id": "0001-acme-rebrand",
			"slug": "acme-rebrand",
			"client": "ACME Studio",
			"country": "Brazil",
			"segment": "Hospitality",
			"year": 2025,
			"category": "Brand Identity",
			"tags": ["logo", "typography", "art direction"],
			"shortDescription": "A short lead-in headline for the project.",
			"description": [
				{ "type": "p", "text": "First paragraph of the case study." },
				{ "type": "p", "text": "Second paragraph of the case study." }
			],
			"images": [
				{ "url": "/projects/acme-rebrand/01.jpg", "alt": "ACME Rebrand — logo sheet" },
				{ "url": "/projects/acme-rebrand/02.jpg", "alt": "ACME Rebrand — packaging" }
			],
			"thumbnail": "/projects/acme-rebrand/thumb.gif"
		}
	]
}
