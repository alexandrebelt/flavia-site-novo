---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { loadProject, projectCover } from "../../lib/server/site-data";
import { sanitizeRichText } from "../../lib/server/sanitize-rich-text.js";

// Looked up per request, so a project created or edited in the admin is
// live right away — no build step lists the slugs ahead of time.
const project = Astro.params.slug ? await loadProject(env.DB, Astro.params.slug) : null;
if (!project) {
	return Astro.rewrite("/404");
}

// Same block tags the admin editor produces (ProjectForm's validBlockTags);
// anything else stored in the row renders as a paragraph. The text is
// sanitized again here (it already is on save) so a row edited any other
// way still can't inject markup.
const BLOCK_TAGS = new Set(["h1", "h2", "h3", "h4", "h5", "h6", "p"]);
const blockTag = (type: string) => (BLOCK_TAGS.has(type) ? type : "p");
---

<Layout
	title={project.client}
	description={project.shortDescription}
	ogImage={projectCover(project) || undefined}
>
	<section class="single-project">
		<div class="single-project-wrapper limit">
			<a href="/portfolio" class="back">&larr; Back to portfolio</a>
			<div class="project-text-content">
				<dl class="facts">
					<div>
						<dd class="project-client-category">
							<span>{project.category}</span>
						</dd>
						<dd class="project-client-name">{project.client}</dd>
						<dd>{project.country}</dd>
						<dd>{project.segment}</dd>
						<dd>{project.year}</dd>
					</div>
					<!-- 	{
						project.tags?.length > 0 && (
						<div>
							<dd>{project.tags.join(", ")}</dd>
							</div>
							)
							}-->
				</dl>

				<div class="project-text-content-col">
					<dd class="project-client-title">{project.client}</dd>
					{
						project.shortDescription && (
							<h4 class="short-description">
								{project.shortDescription}
							</h4>
						)
					}
					{
						project.description?.length > 0 && (
							<div class="description">
								{project.description.map((block) => {
									const Tag = blockTag(block.type);
									return <Tag set:html={sanitizeRichText(block.text)} />;
								})}
							</div>
						)
					}
				</div>
			</div>
			<div class="gallery">
				{
					project.images?.map((image) => (
						<img src={image.url} alt={image.alt} loading="lazy" />
					))
				}
			</div>
		</div>
	</section>
</Layout>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { whenPageSettled } from "../../scripts/scroll-timing";

	gsap.registerPlugin(ScrollTrigger);

	let detailTrigger: ScrollTrigger | null = null;
	let galleryTriggers: ScrollTrigger[] = [];

	function initProjectDetailReveal() {
		detailTrigger?.kill();
		detailTrigger = null;
		galleryTriggers.forEach((trigger) => trigger.kill());
		galleryTriggers = [];

		// Two blocks, each fading in as a whole — the facts list, then the
		// text column — rather than their contents staggering in piece by piece.
		const blocks = [
			document.querySelector<HTMLElement>(".project-text-content .facts"),
			document.querySelector<HTMLElement>(".project-text-content-col"),
		].filter((el): el is HTMLElement => !!el);
		const images = document.querySelectorAll<HTMLElement>(".gallery img");

		if (blocks.length) gsap.set(blocks, { opacity: 0 });
		if (images.length) gsap.set(images, { opacity: 0 });

		whenPageSettled(() => {
			if (blocks.length) {
				const timeline = gsap.timeline({
					scrollTrigger: {
						trigger: ".project-text-content",
						start: "top 80%",
						toggleActions: "play none none reverse",
					},
				});
				blocks.forEach((block) => {
					timeline.to(block, { opacity: 1, duration: 0.6, ease: "power2.out" }, ">");
				});
				detailTrigger = timeline.scrollTrigger ?? null;
			}

			// Further down, each gallery image fades in on its own as it
			// scrolls into view — tied to a real duration, not scrubbed to
			// scroll position.
			images.forEach((img) => {
				const tween = gsap.to(img, {
					opacity: 1,
					duration: 0.6,
					ease: "power2.out",
					scrollTrigger: {
						trigger: img,
						start: "top 85%",
						toggleActions: "play none none reverse",
					},
				});
				if (tween.scrollTrigger) galleryTriggers.push(tween.scrollTrigger);
			});
		});
	}

	function cleanupProjectDetailReveal() {
		detailTrigger?.kill();
		detailTrigger = null;
		galleryTriggers.forEach((trigger) => trigger.kill());
		galleryTriggers = [];
	}

	document.addEventListener("astro:page-load", initProjectDetailReveal);
	document.addEventListener("astro:before-swap", cleanupProjectDetailReveal);
</script>

<style>
	.back {
		display: inline-block;
		margin-bottom: 1.5rem;
		font-size: 0.9rem;
		color: #555;
		text-decoration: none;
	}

	.back:hover {
		color: #1a1a1a;
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 1rem 2rem;
		margin: 0 0 2.5rem;
		text-transform: uppercase;
	}
	.project-text-content dd {
		margin: 0;
	}

	.project-text-content-col {
		max-width: 90ch;
		margin: 0 0 2.5rem;
	}
	.project-client-title {
		text-transform: uppercase !important;
	}
	.short-description {
		padding-bottom: 4rem;
		padding-top: 1.5rem;
	}

	.description :global(p) {
		margin: 0 0 1rem;
		line-height: 1.7;
	}

	.gallery {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.gallery img {
		width: 100%;
		border-radius: 4px;
		object-fit: contain;
		height: auto;
	}

	.content {
		margin-top: 2rem;
		max-width: 70ch;
		line-height: 1.7;
		color: #333;
	}
	.project-text-content {
		display: flex;
		flex-direction: row;
		gap: 2rem;
		justify-content: space-between;
	}
	.project-client-category {
		width: fit-content;
		padding-bottom: 3em;
	}
	.project-client-category span {
		border-bottom: 1px solid var(--color-dark-gray);
	}

	@media (max-width: 656px) {
		.project-text-content {
			flex-direction: column !important;
		}
		.project-text-content .facts {
			margin: 0;
		}
		.project-client-category {
			padding-bottom: 2em !important;
		}
		.facts,
		.project-client-title {
			font-size: 11px;
		}
		.project-text-content .project-client-name {
			display: none !important;
		}
		.short-description {
			padding-top: 0.5em;
			padding-bottom: 1.5em;
		}
		.single-project-wrapper.limit {
			padding-bottom: 0;
		}
	}
</style>
