---
import Layout from "../../layouts/Layout.astro";
import ProjectsGrid from "../../components/ProjectsGrid.astro";
---

<Layout
	title="Portfolio"
	description="A collection of brand identity projects built for founders who treat branding as an investment — distinctive, considered and built to last."
>
	<section class="portfolio-section limit">
		<div class="portfolio-top-section-row row">
			<div class="portfolio-top-section-col col">
				<h5>
					A collection of identities built for founders who treat
					branding as an investment.
				</h5>
			</div>
			<div class="portfolio-top-section-col col">
				<p>
					Each project is shaped into a distinct visual world,
					designed to feel considered, ownable and built to last.
				</p>
			</div>
		</div>

		<ProjectsGrid paginate />
	</section>
</Layout>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { whenPageSettled } from "../../scripts/scroll-timing";

	gsap.registerPlugin(ScrollTrigger);

	let portfolioTopTrigger: ScrollTrigger | null = null;

	function initPortfolioTopReveal() {
		portfolioTopTrigger?.kill();
		portfolioTopTrigger = null;

		const cols = document.querySelectorAll<HTMLElement>(".portfolio-top-section-col");
		if (!cols.length) return;

		gsap.set(cols, { opacity: 0 });

		whenPageSettled(() => {
			const timeline = gsap.timeline({
				scrollTrigger: {
					trigger: ".portfolio-top-section-row",
					start: "top 80%",
					toggleActions: "play none none reverse",
				},
			});
			timeline.to(cols, {
				opacity: 1,
				duration: 0.6,
				ease: "power2.out",
			});
			portfolioTopTrigger = timeline.scrollTrigger ?? null;
		});
	}

	document.addEventListener("astro:page-load", initPortfolioTopReveal);

	document.addEventListener("astro:before-swap", () => {
		portfolioTopTrigger?.kill();
		portfolioTopTrigger = null;
	});
</script>

<style>
	.portfolio-top-section-row {
		width: 100%;
		align-items: flex-start;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 2rem;
	}
	.portfolio-top-section-col {
		max-width: clamp(450px, 45vw, 560px);
	}
	.portfolio-top-section-col p {
		max-width: 25rem;
	}

	@media(max-width: 941px){
		.portfolio-top-section-row{
			gap: 0;
		} 
	}
	@media(max-width: 695px){
		.portfolio-section{
			padding-bottom: 0 !important;
		}
	}
		
</style>
