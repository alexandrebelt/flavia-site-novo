---
export const prerender = false;

import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getSettings } from "../../../lib/server/settings-store.js";
import { normalizeRecognitions } from "../../../data/recognitions";

const settings = await getSettings(env.DB);
const about = settings.about ?? { heroImageUrl: "", recognitions: [] };
// "<" escaped so no saved text can close the <script> it's embedded in.
const initialRecognitionsJson = JSON.stringify(normalizeRecognitions(about.recognitions)).replace(
	/</g,
	"\\u003c",
);
---

<AdminLayout title="About">
	<div class="admin-card" style="margin-bottom: 1.5rem;">
		<h2 class="block-title">Photo — Opening section</h2>
		<p class="admin-hint" style="margin-bottom: 1.25rem;">
			Background photo of the About page's first section. Recommended:
			landscape, at least 1600px wide, JPG, PNG or WebP. Automatically resized
			and converted to WebP when uploaded.
		</p>
		<div class="photo-field">
			<div class="photo-preview">
				<img id="photo-preview" src={about.heroImageUrl || "/favicon.svg"} alt="" />
			</div>
			<div class="photo-controls">
				<div class="admin-field">
					<label>Photo</label>
					<div class="upload-row">
						<span id="photo-filename" class="admin-hint">
							{about.heroImageUrl || "Using the theme's default photo"}
						</span>
						<label class="admin-btn secondary" style="cursor: pointer;">
							Upload photo
							<input type="file" id="photo-input" accept="image/*" style="display:none;" />
						</label>
					</div>
				</div>
				<div class="admin-form-actions">
					<button type="button" id="reset-photo" class="admin-btn secondary">
						Restore theme default
					</button>
				</div>
			</div>
		</div>
	</div>

	<div class="admin-card">
		<h2 class="block-title">Recognitions</h2>
		<p class="admin-hint" style="margin-bottom: 1.25rem;">
			List shown in the About page's "Selected Recognition" section. Add a
			link (https://…) to make an item clickable — it opens in a new tab.
			Items without a link show as plain text.
		</p>
		<div id="recognitions-list"></div>
		<button type="button" class="admin-btn secondary" id="add-recognition" style="width: fit-content;">
			+ Add recognition
		</button>
	</div>

	<div class="admin-form-actions">
		<button type="button" id="save-all" class="admin-btn">Save</button>
	</div>
</AdminLayout>

<div class="admin-toast" id="toast"></div>

<style is:global>
	/* .recognition-row is built at runtime via innerHTML, so it never gets
	   Astro's scoped-style attribute — this whole block has to be global. */
	.block-title {
		font-size: 1.1rem;
		font-family: var(--font-sans);
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	.photo-field {
		display: flex;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.photo-preview {
		width: 220px;
		aspect-ratio: 16 / 10;
		background: var(--color-offwhite);
		border-radius: 6px;
		overflow: hidden;
		flex-shrink: 0;
	}

	.photo-preview img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.photo-controls {
		flex: 1;
		min-width: 240px;
	}

	.upload-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.upload-row span {
		overflow-wrap: anywhere;
	}

	.recognition-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.6rem;
	}

	.recognition-row input {
		flex: 1;
		min-width: 0;
		font-family: var(--font-sans);
		font-size: 0.95rem;
		padding: 0.65rem 0.8rem;
		border: 1px solid rgba(14, 14, 14, 0.14);
		border-radius: 7px;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.recognition-row .recognition-url {
		flex: 0.8;
	}

	.recognition-row input[aria-invalid="true"] {
		border-color: #b3261e;
	}

	.recognition-row input:hover {
		border-color: rgba(14, 14, 14, 0.24);
	}

	.recognition-row input:focus {
		outline: none;
		border-color: var(--color-black);
		box-shadow: 0 0 0 3px rgba(14, 14, 14, 0.08);
	}

	#add-recognition {
		margin-bottom: 1.5rem;
	}
</style>

<script>
	import { compressImage } from "../../../scripts/admin/image-compression";
	import { isValidRecognitionUrl, type Recognition } from "../../../data/recognitions";
	const DEFAULT_PHOTO_LABEL = "Using the theme's default photo";

	function toast(message: string, isError = false) {
		const el = document.getElementById("toast")!;
		el.textContent = message;
		el.classList.toggle("error", isError);
		el.classList.add("visible");
		setTimeout(() => el.classList.remove("visible"), 2500);
	}

	async function uploadFile(file: File): Promise<string> {
		// Photos are resized and converted to WebP first (videos pass through).
		file = await compressImage(file);
		const body = new FormData();
		body.append("file", file);
		const res = await fetch("/api/admin/upload", { method: "POST", body });
		if (!res.ok) {
			// The server says why (type not allowed, too large...).
			const err = (await res.json().catch(() => ({}))) as { error?: string };
			throw new Error(err.error || "Upload failed.");
		}
		const data = (await res.json()) as { url: string };
		return data.url;
	}

	// ---- hero photo ----
	const photoFilenameEl = document.getElementById("photo-filename")!;
	let heroImageUrl =
		photoFilenameEl.textContent?.trim() === DEFAULT_PHOTO_LABEL
			? ""
			: (photoFilenameEl.textContent?.trim() ?? "");

	const photoPreview = document.getElementById("photo-preview") as HTMLImageElement;
	const photoInput = document.getElementById("photo-input") as HTMLInputElement;

	photoInput.addEventListener("change", async () => {
		const file = photoInput.files?.[0];
		if (!file) return;
		try {
			heroImageUrl = await uploadFile(file);
			photoFilenameEl.textContent = heroImageUrl;
			photoPreview.src = heroImageUrl;
			toast("Photo uploaded. Click Save to publish.");
		} catch (err) {
			toast(err instanceof Error ? err.message : "Couldn't upload the photo.", true);
		}
	});

	document.getElementById("reset-photo")!.addEventListener("click", async () => {
		heroImageUrl = "";
		photoFilenameEl.textContent = DEFAULT_PHOTO_LABEL;
		photoPreview.src = "/favicon.svg";
		const res = await fetch("/api/admin/settings", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ about: { heroImageUrl: "" } }),
		});
		if (res.ok) toast("Default photo restored.");
		else toast("Couldn't save.", true);
	});

	// ---- recognitions ----
	const initialRecognitions = JSON.parse(
		document.getElementById("initial-recognitions")?.textContent || "[]",
	);
	const recognitionsList = document.getElementById("recognitions-list")!;

	function addRecognitionRow({ text = "", url = "" }: Partial<Recognition> = {}) {
		const row = document.createElement("div");
		row.className = "recognition-row";
		row.innerHTML = `
			<input type="text" class="recognition-text" placeholder="E.g. Behance — Featured Project" aria-label="Recognition" />
			<input type="url" class="recognition-url" placeholder="Link (optional) — https://…" aria-label="Link" />
			<button type="button" class="icon-btn danger row-remove" title="Remove">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
			</button>
		`;
		(row.querySelector(".recognition-text") as HTMLInputElement).value = text;
		const urlInput = row.querySelector(".recognition-url") as HTMLInputElement;
		urlInput.value = url;
		// Once flagged, the link re-checks as it's edited, so the red border clears.
		urlInput.addEventListener("input", () => {
			if (urlInput.getAttribute("aria-invalid") === "true") validateRecognitionLinks();
		});
		row.querySelector(".row-remove")!.addEventListener("click", () => row.remove());
		recognitionsList.appendChild(row);
	}

	(initialRecognitions as Recognition[]).forEach((item) => addRecognitionRow(item));
	document.getElementById("add-recognition")!.addEventListener("click", () => {
		addRecognitionRow();
		recognitionsList.lastElementChild
			?.querySelector(".recognition-text")
			?.scrollIntoView({ block: "nearest" });
		(recognitionsList.lastElementChild?.querySelector(".recognition-text") as HTMLInputElement)?.focus();
	});

	// A link is optional, but if one is typed it must be a full web address.
	function validateRecognitionLinks(): boolean {
		let valid = true;
		recognitionsList.querySelectorAll<HTMLInputElement>(".recognition-url").forEach((input) => {
			const value = input.value.trim();
			const ok = !value || isValidRecognitionUrl(value);
			input.setAttribute("aria-invalid", String(!ok));
			if (!ok) valid = false;
		});
		return valid;
	}

	function readRecognitions(): Recognition[] {
		return Array.from(recognitionsList.querySelectorAll<HTMLElement>(".recognition-row"))
			.map((row) => ({
				text: (row.querySelector(".recognition-text") as HTMLInputElement).value.trim(),
				url: (row.querySelector(".recognition-url") as HTMLInputElement).value.trim(),
			}))
			.filter((item) => item.text);
	}

	document.getElementById("save-all")!.addEventListener("click", async () => {
		if (!validateRecognitionLinks()) {
			toast("Fix the highlighted links — they must start with https://", true);
			return;
		}
		const res = await fetch("/api/admin/settings", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ about: { heroImageUrl, recognitions: readRecognitions() } }),
		});
		if (res.ok) toast("Changes saved.");
		else toast("Couldn't save.", true);
	});
</script>

<script type="application/json" id="initial-recognitions" set:html={initialRecognitionsJson} />
