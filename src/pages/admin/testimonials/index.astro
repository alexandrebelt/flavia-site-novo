---
export const prerender = false;

import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { loadSiteSettings } from "../../../lib/server/site-data";
import { normalizeTestimonials } from "../../../data/testimonials";

const settings = await loadSiteSettings(env.DB);
// "<" escaped so no saved text can close the <script> it's embedded in.
const initialJson = JSON.stringify(normalizeTestimonials(settings.testimonials)).replace(
	/</g,
	"\\u003c",
);
---

<AdminLayout title="Testimonials">
	<div class="admin-card">
		<h2 class="testimonials-title">Testimonials</h2>
		<p class="admin-hint testimonials-intro">
			Shown on the home page, one at a time — they take turns every few seconds
			(with dots to switch) when more than one is visible. The{" "}
			<strong>quote</strong> goes in large type; <strong>client, company</strong>{" "}
			go below it. Drag by the <span aria-hidden="true">⠿</span> handle to set the
			order; the <strong>eye</strong> shows or hides a testimonial on the site
			without deleting it. No need to type quotation marks — the site adds them.
		</p>

		<div id="testimonials-list"></div>
		<p id="testimonials-empty" class="admin-hint" hidden>
			No testimonials yet — the section is hidden on the site until one is added
			and visible.
		</p>

		<button type="button" class="admin-btn secondary" id="add-testimonial">+ Add testimonial</button>
	</div>

	<div class="admin-form-actions">
		<button type="button" id="save-all" class="admin-btn">Save</button>
	</div>

	<template id="testimonial-template">
		<div class="testimonial-row">
			<button type="button" class="icon-btn drag-handle" title="Drag to reorder">
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<circle cx="9" cy="6" r="1.6"></circle>
					<circle cx="15" cy="6" r="1.6"></circle>
					<circle cx="9" cy="12" r="1.6"></circle>
					<circle cx="15" cy="12" r="1.6"></circle>
					<circle cx="9" cy="18" r="1.6"></circle>
					<circle cx="15" cy="18" r="1.6"></circle>
				</svg>
			</button>
			<div class="testimonial-fields admin-field">
				<div class="testimonial-names">
					<input type="text" class="t-client" placeholder="Client name" aria-label="Client name" />
					<input type="text" class="t-company" placeholder="Company" aria-label="Company" />
				</div>
				<textarea class="t-quote" rows="3" placeholder="Testimonial" aria-label="Testimonial"></textarea>
			</div>
			<button type="button" class="icon-btn visibility-toggle" aria-pressed="true">
				<svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path>
					<circle cx="12" cy="12" r="3"></circle>
				</svg>
				<svg class="eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M3 3l18 18"></path>
					<path d="M10.6 5.1A10.4 10.4 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-2.6 3.5M6.6 6.6A17.2 17.2 0 0 0 2 12s3.5 7 10 7a9.8 9.8 0 0 0 5.4-1.6"></path>
					<path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path>
				</svg>
			</button>
			<button type="button" class="icon-btn danger row-remove" title="Delete testimonial">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
		</div>
	</template>
</AdminLayout>

<div class="admin-toast" id="toast"></div>

<script type="application/json" id="initial-testimonials" set:html={initialJson} />

<script>
	import type { Testimonial } from "../../../data/testimonials";

	function toast(message: string, isError = false) {
		const el = document.getElementById("toast")!;
		el.textContent = message;
		el.classList.toggle("error", isError);
		el.classList.add("visible");
		setTimeout(() => el.classList.remove("visible"), 2500);
	}

	const list = document.getElementById("testimonials-list")!;
	const emptyState = document.getElementById("testimonials-empty")!;
	const template = document.getElementById("testimonial-template") as HTMLTemplateElement;
	let dirty = false;

	function syncEmptyState() {
		emptyState.hidden = list.children.length > 0;
	}

	function setVisible(row: HTMLElement, visible: boolean) {
		const toggle = row.querySelector<HTMLButtonElement>(".visibility-toggle")!;
		row.classList.toggle("is-hidden", !visible);
		toggle.setAttribute("aria-pressed", String(visible));
		const label = visible ? "Visible on the site — click to hide" : "Hidden from the site — click to show";
		toggle.title = label;
		toggle.setAttribute("aria-label", label);
	}

	function addRow(item: Partial<Testimonial> = {}) {
		const fragment = template.content.cloneNode(true) as DocumentFragment;
		const row = fragment.querySelector<HTMLElement>(".testimonial-row")!;
		row.dataset.id = item.id || `t-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 6)}`;
		row.querySelector<HTMLInputElement>(".t-client")!.value = item.client ?? "";
		row.querySelector<HTMLInputElement>(".t-company")!.value = item.company ?? "";
		row.querySelector<HTMLTextAreaElement>(".t-quote")!.value = item.quote ?? "";
		setVisible(row, item.visible !== false);

		row.querySelector(".visibility-toggle")!.addEventListener("click", () => {
			setVisible(row, row.classList.contains("is-hidden"));
			dirty = true;
		});
		row.querySelector(".row-remove")!.addEventListener("click", () => {
			const quote = row.querySelector<HTMLTextAreaElement>(".t-quote")!.value.trim();
			if (quote && !confirm("Delete this testimonial?")) return;
			row.remove();
			syncEmptyState();
			dirty = true;
		});
		row.addEventListener("input", () => {
			dirty = true;
			row.classList.remove("is-invalid");
		});

		// Drag-to-reorder: only the handle starts a drag (same as the project gallery).
		const handle = row.querySelector<HTMLElement>(".drag-handle")!;
		handle.addEventListener("mousedown", () => {
			row.draggable = true;
		});
		row.addEventListener("dragstart", (e) => {
			e.dataTransfer?.setData("text/plain", "");
			row.classList.add("dragging");
		});
		row.addEventListener("dragend", () => {
			row.draggable = false;
			row.classList.remove("dragging");
			dirty = true;
		});

		list.appendChild(row);
		syncEmptyState();
		return row;
	}

	function getDragAfterRow(y: number): HTMLElement | null {
		const rows = Array.from(list.querySelectorAll<HTMLElement>(".testimonial-row:not(.dragging)"));
		return rows.reduce(
			(closest, row) => {
				const box = row.getBoundingClientRect();
				const offset = y - box.top - box.height / 2;
				if (offset < 0 && offset > closest.offset) return { offset, element: row };
				return closest;
			},
			{ offset: Number.NEGATIVE_INFINITY, element: null as HTMLElement | null },
		).element;
	}

	list.addEventListener("dragover", (e) => {
		const dragging = list.querySelector<HTMLElement>(".dragging");
		if (!dragging) return;
		e.preventDefault();
		const after = getDragAfterRow((e as DragEvent).clientY);
		if (after) list.insertBefore(dragging, after);
		else list.appendChild(dragging);
	});

	const initial = JSON.parse(
		document.getElementById("initial-testimonials")?.textContent || "[]",
	) as Testimonial[];
	initial.forEach((item) => addRow(item));
	syncEmptyState();

	document.getElementById("add-testimonial")!.addEventListener("click", () => {
		const row = addRow();
		row.querySelector<HTMLInputElement>(".t-client")!.focus();
		dirty = true;
	});

	function readRows() {
		return Array.from(list.querySelectorAll<HTMLElement>(".testimonial-row")).map((row) => ({
			row,
			id: row.dataset.id!,
			client: row.querySelector<HTMLInputElement>(".t-client")!.value.trim(),
			company: row.querySelector<HTMLInputElement>(".t-company")!.value.trim(),
			quote: row.querySelector<HTMLTextAreaElement>(".t-quote")!.value.trim(),
			visible: !row.classList.contains("is-hidden"),
		}));
	}

	document.getElementById("save-all")!.addEventListener("click", async () => {
		const rows = readRows();
		// A row with a name but no quote is almost certainly unfinished.
		const incomplete = rows.filter((r) => !r.quote && (r.client || r.company));
		rows.forEach((r) => r.row.classList.toggle("is-invalid", incomplete.includes(r)));
		if (incomplete.length) {
			toast("Add the testimonial text to the highlighted entries (or delete them).", true);
			return;
		}

		const testimonials = rows
			.filter((r) => r.quote)
			.map(({ id, client, company, quote, visible }) => ({ id, client, company, quote, visible }));
		const res = await fetch("/api/admin/settings", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ testimonials }),
		});
		if (res.ok) {
			dirty = false;
			rows.filter((r) => !r.quote).forEach((r) => r.row.remove());
			syncEmptyState();
			const shown = testimonials.filter((t) => t.visible).length;
			toast(`Saved — ${shown} of ${testimonials.length} visible on the site.`);
		} else {
			toast("Couldn't save.", true);
		}
	});

	// Leaving with unsaved changes asks first.
	window.addEventListener("beforeunload", (e) => {
		if (dirty) e.preventDefault();
	});
</script>

<style>
	.testimonials-title {
		font-size: 1.1rem;
		font-family: var(--font-sans);
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	.testimonials-intro {
		margin-bottom: 1.5rem;
		max-width: 75ch;
	}

	#add-testimonial {
		width: fit-content;
		margin-top: 0.5rem;
	}

	.testimonial-row {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		padding: 0.75rem;
		margin-bottom: 0.75rem;
		border: 1px solid rgba(14, 14, 14, 0.1);
		border-radius: 10px;
		background: #fff;
		transition: opacity 0.2s ease, border-color 0.2s ease;
	}

	.testimonial-row.is-hidden .testimonial-fields {
		opacity: 0.45;
	}

	.testimonial-row.is-invalid {
		border-color: #b3261e;
	}

	.testimonial-row.dragging {
		opacity: 0.4;
	}

	.testimonial-fields {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin: 0;
	}

	.testimonial-names {
		display: flex;
		gap: 0.5rem;
	}

	.testimonial-names input {
		flex: 1;
		min-width: 0;
	}

	.testimonial-fields textarea {
		resize: vertical;
		min-height: 4.5rem;
	}

	.drag-handle {
		cursor: grab;
		margin-top: 0.35rem;
	}

	.drag-handle:active {
		cursor: grabbing;
	}

	.visibility-toggle,
	.row-remove {
		margin-top: 0.35rem;
	}

	.visibility-toggle .eye-closed,
	.testimonial-row.is-hidden .visibility-toggle .eye-open {
		display: none;
	}

	.testimonial-row.is-hidden .visibility-toggle .eye-closed {
		display: block;
	}

	.testimonial-row.is-hidden .visibility-toggle {
		color: var(--color-gray);
	}

	@media (max-width: 720px) {
		.testimonial-names {
			flex-direction: column;
		}
	}
</style>
