---
export const prerender = false;

import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getSettings } from "../../../lib/server/settings-store.js";
import { SOCIAL_NETWORKS } from "../../../data/social-links";

const settings = await getSettings(env.DB);
---

<AdminLayout title="Settings">
	<div class="admin-card" style="max-width: 480px; margin-bottom: 1.5rem;">
		<h2 class="block-title">Favicon</h2>
		<p class="admin-hint" style="margin-bottom: 1.25rem;">
			Icon shown in the browser tab. Recommended: a square image, PNG or
			SVG, at least 64×64px.
		</p>
		<div class="favicon-field">
			<div class="favicon-preview">
				<img id="favicon-preview" src={settings.siteFaviconUrl || "/favicon.svg"} alt="" />
			</div>
			<div style="flex: 1; min-width: 200px;">
				<div class="upload-row">
					<span id="favicon-filename" class="admin-hint">
						{settings.siteFaviconUrl || "Using the theme's default favicon"}
					</span>
					<label class="admin-btn secondary" style="cursor: pointer;">
						Upload favicon
						<input type="file" id="favicon-input" accept="image/*" style="display:none;" />
					</label>
				</div>
				<div class="admin-form-actions">
					<button type="button" id="reset-favicon" class="admin-btn secondary">
						Restore default
					</button>
				</div>
			</div>
		</div>
	</div>

	<div class="admin-card" style="max-width: 640px; margin-top: 1.5rem;">
		<h2 class="block-title">SEO</h2>
		<p class="admin-hint" style="margin-bottom: 1.25rem;">
			Used in every page's meta tags (title, description, Open Graph,
			Twitter Card), in the sitemap and for search engine indexing. Saving
			publishes the new values right away — Google and link previews
			(WhatsApp, LinkedIn) pick them up the next time they visit the page.
		</p>

		<div class="admin-field">
			<label for="f-seo-site-title">Site title</label>
			<input id="f-seo-site-title" value={settings.siteTitle || ""} required />
			<p class="admin-hint">
				Used in the site's page &lt;title&gt; ("Title — About") and in the
				og:site_name tag shown when a link is shared.
			</p>
		</div>

		<div class="admin-field">
			<label for="f-seo-site-url">Site URL</label>
			<input
				id="f-seo-site-url"
				value={settings.seo?.siteUrl || ""}
				placeholder="https://flaviajackeline.com"
			/>
			<p class="admin-hint">
				Used to build each page's canonical link and the absolute Open
				Graph/Twitter URLs. No trailing slash.
			</p>
		</div>

		<div class="admin-field">
			<label for="f-seo-description">Default description (meta description)</label>
			<textarea id="f-seo-description" rows="3">{settings.seo?.defaultDescription || ""}</textarea>
			<p class="admin-hint">
				Used when a page doesn't set its own description. Ideally 120 to
				160 characters.
			</p>
		</div>

		<div class="admin-field">
			<label>Share image (Open Graph / Twitter)</label>
			<div class="favicon-field">
				<div class="favicon-preview" style="width: 160px; height: 84px; border-radius: 6px;">
					<img id="og-image-preview" src={settings.seo?.ogImageUrl || "/favicon.svg"} alt="" />
				</div>
				<div style="flex: 1; min-width: 200px;">
					<div class="upload-row">
						<span id="og-image-filename" class="admin-hint">
							{settings.seo?.ogImageUrl || "No image set"}
						</span>
						<label class="admin-btn secondary" style="cursor: pointer;">
							Upload image
							<input type="file" id="og-image-input" accept="image/*" style="display:none;" />
						</label>
					</div>
				</div>
			</div>
			<p class="admin-hint">
				Shown when the site's link is shared on WhatsApp, Twitter/X,
				LinkedIn, etc. Recommended: 1200×630px.
			</p>
		</div>

		<div class="admin-field-row">
			<div class="admin-field">
				<label for="f-seo-twitter">X/Twitter handle</label>
				<input id="f-seo-twitter" value={settings.seo?.twitterHandle || ""} placeholder="flaviajackeline" />
			</div>
			<div class="admin-field">
				<label for="f-seo-google-verification">Google Search Console verification</label>
				<input
					id="f-seo-google-verification"
					value={settings.seo?.googleSiteVerification || ""}
					placeholder="Verification meta tag code"
				/>
			</div>
		</div>

		<h3 class="block-subtitle">Social media</h3>
		<p class="admin-hint" style="margin-bottom: 1rem;">
			Links for the footer's "Connect" column and the About page's contact
			list. Use the full profile URL (https://…) on the network's own
			domain. An empty field links to the network's homepage.
		</p>
		{
			SOCIAL_NETWORKS.map((network) => (
				<div class="admin-field">
					<label for={`f-social-${network.key}`}>{network.label}</label>
					<input
						id={`f-social-${network.key}`}
						class="social-link-input"
						data-social-key={network.key}
						type="url"
						value={settings.seo?.socialLinks?.[network.key] || ""}
						placeholder={`${network.defaultUrl}your-profile`}
					/>
					<p class="admin-hint social-link-error" hidden></p>
				</div>
			))
		}

		<label class="seo-checkbox">
			<input
				type="checkbox"
				id="f-seo-allow-indexing"
				checked={settings.seo?.allowIndexing !== false}
			/>
			Allow search engines to index the site
		</label>
		<p class="admin-hint" style="margin-bottom: 1.25rem;">
			Only uncheck on test/staging environments — it tells Google and
			other search engines not to list the site in search results.
		</p>

	</div>

	<div class="admin-form-actions">
		<button type="button" id="save-all" class="admin-btn">Save</button>
	</div>

	<div class="admin-card" style="max-width: 480px; margin-top: 1.5rem;">
		<h2 class="block-title">Security</h2>
		<p class="admin-hint" style="margin-bottom: 1.25rem;">
			Change the admin password. The new password needs at least 10
			characters, with an uppercase letter, a lowercase letter, a number
			and a special character.
		</p>

		<div class="admin-field">
			<label for="f-current-password">Current password</label>
			<input id="f-current-password" type="password" autocomplete="current-password" />
		</div>

		<div class="admin-field">
			<label for="f-new-password">New password</label>
			<input id="f-new-password" type="password" autocomplete="new-password" />
		</div>

		<div class="admin-field">
			<label for="f-confirm-password">Confirm new password</label>
			<input id="f-confirm-password" type="password" autocomplete="new-password" />
		</div>

		<div class="admin-form-actions">
			<button type="button" id="change-password" class="admin-btn">Change password</button>
		</div>
	</div>
</AdminLayout>

<div class="admin-toast" id="toast"></div>

<script>
	import { SOCIAL_NETWORKS, isValidSocialUrl, type SocialKey } from "../../../data/social-links";

	function toast(message: string, isError = false) {
		const el = document.getElementById("toast")!;
		el.textContent = message;
		el.classList.toggle("error", isError);
		el.classList.add("visible");
		setTimeout(() => el.classList.remove("visible"), 2500);
	}

	// ---- favicon ----
	const DEFAULT_FAVICON_LABEL = "Using the theme's default favicon";
	const faviconFilenameEl = document.getElementById("favicon-filename")!;
	let siteFaviconUrl =
		faviconFilenameEl.textContent?.trim() === DEFAULT_FAVICON_LABEL
			? ""
			: (faviconFilenameEl.textContent?.trim() ?? "");

	const faviconPreview = document.getElementById("favicon-preview") as HTMLImageElement;
	const faviconInput = document.getElementById("favicon-input") as HTMLInputElement;

	async function uploadFile(file: File): Promise<string> {
		const body = new FormData();
		body.append("file", file);
		const res = await fetch("/api/admin/upload", { method: "POST", body });
		if (!res.ok) {
			// The server says why (type not allowed, too large...).
			const err = (await res.json().catch(() => ({}))) as { error?: string };
			throw new Error(err.error || "Upload failed.");
		}
		const data = (await res.json()) as { url: string };
		return data.url;
	}

	faviconInput.addEventListener("change", async () => {
		const file = faviconInput.files?.[0];
		if (!file) return;
		try {
			siteFaviconUrl = await uploadFile(file);
			faviconFilenameEl.textContent = siteFaviconUrl;
			faviconPreview.src = siteFaviconUrl;
			toast("Favicon uploaded. Click Save to publish.");
		} catch (err) {
			toast(err instanceof Error ? err.message : "Couldn't upload the favicon.", true);
		}
	});

	document.getElementById("reset-favicon")!.addEventListener("click", async () => {
		siteFaviconUrl = "";
		faviconFilenameEl.textContent = DEFAULT_FAVICON_LABEL;
		faviconPreview.src = "/favicon.svg";
		const res = await fetch("/api/admin/settings", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ siteFaviconUrl: "" }),
		});
		if (res.ok) toast("Default favicon restored.");
		else toast("Couldn't save.", true);
	});

	// ---- SEO ----
	const ogImageFilenameEl = document.getElementById("og-image-filename")!;
	let ogImageUrl =
		ogImageFilenameEl.textContent?.trim() === "No image set"
			? ""
			: (ogImageFilenameEl.textContent?.trim() ?? "");

	const ogImagePreview = document.getElementById("og-image-preview") as HTMLImageElement;
	const ogImageInput = document.getElementById("og-image-input") as HTMLInputElement;

	ogImageInput.addEventListener("change", async () => {
		const file = ogImageInput.files?.[0];
		if (!file) return;
		try {
			ogImageUrl = await uploadFile(file);
			ogImageFilenameEl.textContent = ogImageUrl;
			ogImagePreview.src = ogImageUrl;
			toast("Image uploaded. Click Save to publish.");
		} catch (err) {
			toast(err instanceof Error ? err.message : "Couldn't upload the image.", true);
		}
	});

	// Each social field must be empty or a URL on that network's own domain
	// (the server re-checks and drops anything else).
	function validateSocialLinks(): boolean {
		let valid = true;
		document.querySelectorAll<HTMLInputElement>(".social-link-input").forEach((input) => {
			const key = input.dataset.socialKey as SocialKey;
			const value = input.value.trim();
			const ok = !value || isValidSocialUrl(key, value);
			const error = input.parentElement?.querySelector<HTMLElement>(".social-link-error");
			if (error) {
				const network = SOCIAL_NETWORKS.find((n) => n.key === key);
				error.hidden = ok;
				error.textContent = ok ? "" : `Use a full ${network?.label} link, e.g. ${network?.defaultUrl}your-profile`;
			}
			input.setAttribute("aria-invalid", String(!ok));
			if (!ok) valid = false;
		});
		return valid;
	}

	// Checked when saving (not on blur: an error appearing as the field loses
	// focus pushes the Save button down mid-click, swallowing that click).
	// Once flagged, a field re-checks as it's edited, so the error clears.
	document.querySelectorAll<HTMLInputElement>(".social-link-input").forEach((input) =>
		input.addEventListener("input", () => {
			if (input.getAttribute("aria-invalid") === "true") validateSocialLinks();
		}),
	);

	document.getElementById("save-all")!.addEventListener("click", async () => {
		if (!validateSocialLinks()) {
			toast("Fix the highlighted social media links.", true);
			return;
		}
		const siteTitle = (document.getElementById("f-seo-site-title") as HTMLInputElement).value.trim();
		const seo = {
			siteUrl: (document.getElementById("f-seo-site-url") as HTMLInputElement).value.trim(),
			defaultDescription: (
				document.getElementById("f-seo-description") as HTMLTextAreaElement
			).value.trim(),
			ogImageUrl,
			twitterHandle: (document.getElementById("f-seo-twitter") as HTMLInputElement).value.trim(),
			googleSiteVerification: (
				document.getElementById("f-seo-google-verification") as HTMLInputElement
			).value.trim(),
			allowIndexing: (document.getElementById("f-seo-allow-indexing") as HTMLInputElement).checked,
			socialLinks: Object.fromEntries(
				Array.from(document.querySelectorAll<HTMLInputElement>(".social-link-input")).map(
					(input) => [input.dataset.socialKey, input.value.trim()],
				),
			),
		};

		const res = await fetch("/api/admin/settings", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ siteTitle, siteFaviconUrl, seo }),
		});
		if (res.ok) toast("Changes saved and published.");
		else toast("Couldn't save.", true);
	});

	// ---- security / change password ----
	document.getElementById("change-password")!.addEventListener("click", async () => {
		const currentPassword = (document.getElementById("f-current-password") as HTMLInputElement).value;
		const newPassword = (document.getElementById("f-new-password") as HTMLInputElement).value;
		const confirmPassword = (document.getElementById("f-confirm-password") as HTMLInputElement).value;

		if (!currentPassword || !newPassword) {
			toast("Fill in the current and the new password.", true);
			return;
		}
		if (newPassword !== confirmPassword) {
			toast("The confirmation doesn't match the new password.", true);
			return;
		}

		const res = await fetch("/api/admin/change-password", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ currentPassword, newPassword }),
		});
		const data = (await res.json().catch(() => ({}))) as { error?: string };

		if (res.ok) {
			toast("Password changed. Please log in again.");
			setTimeout(() => {
				window.location.href = "/admin/login";
			}, 1500);
		} else {
			toast(data.error || "Couldn't change the password.", true);
		}
	});
</script>

<style is:global>
	/* Shares the settings page's static markup, but styled globally for
	   consistency with the rest of the admin's icon/photo tiles. */
	.block-title {
		font-size: 1.1rem;
		font-family: var(--font-sans);
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	.block-subtitle {
		font-size: 0.95rem;
		font-family: var(--font-sans);
		font-weight: 600;
		margin: 1.5rem 0 0.4rem;
	}

	.favicon-field {
		display: flex;
		gap: 1.25rem;
		flex-wrap: wrap;
		align-items: flex-start;
	}

	.favicon-preview {
		width: 64px;
		height: 64px;
		background: var(--color-offwhite);
		border-radius: 10px;
		overflow: hidden;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.favicon-preview img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.upload-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 1rem;
	}

	.upload-row span {
		overflow-wrap: anywhere;
	}

	.social-link-error {
		color: #b3261e;
		margin-top: 0.35rem;
	}

	.seo-checkbox {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.9rem;
		color: var(--color-dark-gray);
		margin-bottom: 0.4rem;
		cursor: pointer;
	}

	.seo-checkbox input {
		width: 16px;
		height: 16px;
		accent-color: var(--color-black);
		cursor: pointer;
	}
</style>
