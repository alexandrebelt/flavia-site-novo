---
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import { turnstileSiteKey } from "../lib/server/turnstile.js";
import { STUDIO_PHONE } from "../data/contact";
import i18n from "../data/inquire-i18n.json";

// Rendered in English; the EN/BR switch swaps every [data-i18n*] text
// client-side from the same JSON (see applyLanguage below).
const t = i18n.en;

// All plain, independent checkboxes, shown in two columns. The submitted
// value stays English whatever language is showing, so the studio's email
// reads the same either way — only the visible label is translated.
const scopeOptions = Object.entries(t.scope).map(([key, label]) => ({
	key,
	value: label,
	label,
}));
---

<Layout title="Inquire">
	<section class="full-height inquire-hero-section bg-black">
		<div
			class="inquire-hero-wrapper hero-reveal-wrapper limit center-content"
		>
			<h1>Start a project</h1>
			<h6>
				Have a new brand in the works, or feel like your current
				identity no longer reflects where your business is going? Tell
				me a little about your project below. I’d love to learn more
				about what you’re building and see how I can help.
			</h6>
		</div>
	</section>
	<section class="inquire-section-2">
		<div class="inquire-section-2-wrapper limit">
			<div class="inquire-lang-row">
				<div class="inquire-lang-switch">
					<span class="inquire-lang-label is-active" data-lang-label="en">EN</span>
					<button
						type="button"
						class="inquire-lang-toggle"
						id="inquiry-lang-toggle"
						role="switch"
						aria-checked="false"
						aria-label="Português (Brasil)"
					>
						<span class="inquire-lang-knob"></span>
					</button>
					<span class="inquire-lang-label" data-lang-label="pt">BR</span>
				</div>
			</div>
			<div class="inquire-form-stage" id="inquiry-stage" lang={t.lang}>
				<form
				class="inquire-form"
				id="inquiry-form"
				data-turnstile-sitekey={turnstileSiteKey(env)}
				novalidate
				>
				<!-- Honeypot: invisible to people (and skipped by keyboard and
				screen readers); a bot that fills it is silently dropped
				     by /api/inquiry. -->
				<div class="inquire-hp" aria-hidden="true">
					<label for="inquiry-company">Company</label>
					<input type="text" id="inquiry-company" name="company" tabindex="-1" autocomplete="off" />
				</div>
				<div class="inquire-form-col">
					<div class="field">
						<input
							type="text"
							id="full-name"
							name="fullName"
							placeholder={t.fullName}
							aria-label={t.fullName}
							data-i18n-placeholder="fullName"
							required
						/>
					</div>

					<div class="field">
						<input
							type="text"
							id="location"
							name="location"
							placeholder={t.location}
							aria-label={t.location}
							data-i18n-placeholder="location"
							required
						/>
					</div>

					<div class="field">
						<input
							type="email"
							id="email"
							name="email"
							placeholder={t.email}
							aria-label={t.email}
							data-i18n-placeholder="email"
							required
						/>
					</div>

					<div class="field">
						<input
							type="tel"
							id="phone"
							name="phone"
							placeholder={t.phone}
							aria-label={t.phone}
							data-i18n-placeholder="phone"
							required
						/>
					</div>

					<div class="field">
						<input
							type="text"
							id="website"
							name="website"
							placeholder={t.website}
							aria-label={t.website}
							data-i18n-placeholder="website"
							required
						/>
					</div>

					<div class="field">
						<input
							type="text"
							id="found-studio"
							name="foundStudio"
							placeholder={t.foundStudio}
							aria-label={t.foundStudio}
							data-i18n-placeholder="foundStudio"
							required
						/>
					</div>

					<div class="field">
						<select
							id="proposal-method"
							name="proposalMethod"
							aria-label={t.proposalMethod}
							data-i18n-aria="proposalMethod"
							required
						>
							<option value="" selected disabled data-i18n="proposalMethod"
								>{t.proposalMethod}</option
							>
							<option value="email" data-i18n="proposalEmail">{t.proposalEmail}</option>
							<option value="whatsapp" data-i18n="proposalWhatsapp">{t.proposalWhatsapp}</option>
						</select>
					</div>

					<fieldset class="field scope-field">
						<legend data-i18n="scopeLegend">{t.scopeLegend}</legend>
						<div class="scope-options">
							{
								scopeOptions.map((option) => (
									<label class="scope-option">
										<input type="checkbox" name="scope" value={option.value} />
										<span class="scope-dot" />
										<span data-i18n={`scope.${option.key}`}>{option.label}</span>
									</label>
								))
							}
						</div>
					</fieldset>
				</div>

				<div class="inquire-form-col">
					<div class="field">
						<input
							type="text"
							id="business"
							name="business"
							placeholder={t.business}
							aria-label={t.business}
							data-i18n-placeholder="business"
							required
						/>
					</div>

					<div class="field">
						<textarea
							id="business-description"
							name="businessDescription"
							rows="3"
							placeholder={t.businessDescription}
							aria-label={t.businessDescription}
							data-i18n-placeholder="businessDescription"
							required></textarea>
					</div>

					<div class="field">
						<select
							id="project-type"
							name="projectType"
							aria-label={t.projectType}
							data-i18n-aria="projectType"
							required
						>
							<option value="" selected disabled data-i18n="projectType"
								>{t.projectType}</option
							>
							<option value="new-brand" data-i18n="projectTypeNewBrand">{t.projectTypeNewBrand}</option>
							<option value="redesign" data-i18n="projectTypeRedesign">{t.projectTypeRedesign}</option>
						</select>
					</div>

					<div class="field">
						<select
							id="launch-timing"
							name="launchTiming"
							aria-label={t.launchTiming}
							data-i18n-aria="launchTiming"
							required
						>
							<option value="" selected disabled data-i18n="launchTiming"
								>{t.launchTiming}</option
							>
							<option value="asap" data-i18n="launchAsap">{t.launchAsap}</option>
							<option value="45-days" data-i18n="launch45">{t.launch45}</option>
							<option value="60-days" data-i18n="launch60">{t.launch60}</option>
							<option value="90-days" data-i18n="launch90">{t.launch90}</option>
							<option value="flexible" data-i18n="launchFlexible">{t.launchFlexible}</option>
						</select>
					</div>

					<div class="field">
						<input
							type="text"
							id="investment-range"
							name="investmentRange"
							placeholder={t.investmentRange}
							aria-label={t.investmentRange}
							data-i18n-placeholder="investmentRange"
							required
						/>
					</div>

					<div class="field">
						<textarea
							id="project-details"
							name="projectDetails"
							rows="3"
							placeholder={t.projectDetails}
							aria-label={t.projectDetails}
							data-i18n-placeholder="projectDetails"
							required></textarea>
					</div>

					<div class="inquire-turnstile" id="inquiry-turnstile"></div>
					<div class="inquire-submit-row">
						<button
							type="submit"
							class="btn-secondary"
							id="inquiry-submit-btn"
							data-i18n="submit">{t.submit}</button
						>
						<p
							id="inquiry-status"
							class="inquire-status"
							role="status"
						>
						</p>
					</div>

					<div class="inquire-contact-info">
						<h5>
							<span data-i18n="brazil">{t.brazil}</span> · UTC−3 · <span id="brazil-clock">--:--</span
							>
						</h5>
						<p>
							<a href={STUDIO_PHONE.href}>{STUDIO_PHONE.display}</a>
						</p>
						<p>
							<a href="mailto:studio@flaviajackeline.com"
								>studio@flaviajackeline.com</a
							>
						</p>
					</div>
				</div>
			</form>

			<div class="inquire-success" id="inquiry-success" aria-hidden="true">
				<h1 class="inquire-success-heading" data-i18n="successHeading">{t.successHeading}</h1>
				<h6 class="inquire-success-subtext" data-i18n="successSubtext">{t.successSubtext}</h6>
			</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	import gsap from "gsap";
	import { textRevealHidden, textRevealVisible } from "../scripts/text-reveal";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { playHeroLetterReveal, splitIntoLetterSpans } from "../scripts/hero-letter-reveal";
	import { whenPageSettled } from "../scripts/scroll-timing";
	import { mountTurnstile, type TurnstileWidget } from "../scripts/turnstile";
	import i18n from "../data/inquire-i18n.json";

	gsap.registerPlugin(ScrollTrigger);

	type Lang = keyof typeof i18n;
	const LANG_STORAGE_KEY = "inquire-lang";
	let lang: Lang = "en";

	// Looks up a dotted key ("errors.required", "scope.motion") in the
	// current language, falling back to English, then to the key itself.
	function tr(key: string, forLang: Lang = lang): string {
		const find = (dict: unknown) =>
			key
				.split(".")
				.reduce<unknown>(
					(node, part) =>
						node && typeof node === "object"
							? (node as Record<string, unknown>)[part]
							: undefined,
					dict,
				);
		const value = find(i18n[forLang]) ?? find(i18n.en);
		return typeof value === "string" ? value : key;
	}

	// Rewrites every translatable text under the form stage (and the
	// field errors / status line, which carry data-i18n too once shown).
	function applyLanguage(next: Lang) {
		lang = next;
		const stage = document.getElementById("inquiry-stage");
		if (!stage) return;
		stage.setAttribute("lang", i18n[next].lang);

		stage.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
			const text = tr(el.dataset.i18n!);
			el.textContent = text;
			// The success heading keeps an aria-label once it's been split
			// into letter spans — keep it in step with the visible text.
			if (el.hasAttribute("aria-label")) el.setAttribute("aria-label", text);
		});
		stage
			.querySelectorAll<HTMLInputElement>("[data-i18n-placeholder]")
			.forEach((el) => {
				const text = tr(el.dataset.i18nPlaceholder!);
				el.placeholder = text;
				el.setAttribute("aria-label", text);
			});
		stage.querySelectorAll<HTMLElement>("[data-i18n-aria]").forEach((el) => {
			el.setAttribute("aria-label", tr(el.dataset.i18nAria!));
		});

		const toggle = document.getElementById("inquiry-lang-toggle");
		toggle?.setAttribute("aria-checked", String(next === "pt"));
		toggle?.setAttribute(
			"aria-label",
			next === "pt" ? "Switch to English" : "Mudar para português",
		);
		document
			.querySelectorAll<HTMLElement>("[data-lang-label]")
			.forEach((el) =>
				el.classList.toggle("is-active", el.dataset.langLabel === next),
			);
	}

	function readStoredLang(): Lang {
		try {
			return localStorage.getItem(LANG_STORAGE_KEY) === "pt" ? "pt" : "en";
		} catch {
			return "en";
		}
	}

	function bindLanguageSwitch() {
		const toggle = document.getElementById("inquiry-lang-toggle");
		const stage = document.getElementById("inquiry-stage");
		if (!toggle || !stage || toggle.dataset.bound) return;
		toggle.dataset.bound = "true";

		// A remembered choice is applied instantly on load — the fade is
		// only for switching while looking at the form.
		applyLanguage(readStoredLang());

		let switching = false;
		toggle.addEventListener("click", () => {
			if (switching) return;
			switching = true;
			const next: Lang = lang === "en" ? "pt" : "en";
			try {
				localStorage.setItem(LANG_STORAGE_KEY, next);
			} catch {}

			// Knob and labels move right away; the texts fade out, swap
			// while invisible, then fade back in.
			toggle.setAttribute("aria-checked", String(next === "pt"));
			gsap.to(stage, {
				opacity: 0,
				duration: 0.3,
				ease: "power2.in",
				onComplete: () => {
					applyLanguage(next);
					gsap.to(stage, {
						opacity: 1,
						duration: 0.3,
						ease: "power2.out",
						onComplete: () => {
							switching = false;
						},
					});
				},
			});
		});
	}

	document.addEventListener("astro:page-load", bindLanguageSwitch);

	// Fires right as the page swaps in, same moment the entrance fade
	// starts — see the identical note on index.astro's playHeroReveal.
	document.addEventListener("astro:page-load", playHeroLetterReveal);

	let formRevealTrigger: ScrollTrigger | null = null;

	function initInquireFormReveal() {
		formRevealTrigger?.kill();
		formRevealTrigger = null;

		const items = document.querySelectorAll<HTMLElement>(
			".inquire-lang-switch, .inquire-form-col > *",
		);
		if (!items.length) return;

		gsap.set(items, textRevealHidden());

		whenPageSettled(() => {
			const timeline = gsap.timeline({
				scrollTrigger: {
					trigger: ".inquire-form",
					start: "top 45%",
					toggleActions: "play none none none",
				},
			});
			timeline.to(items, {
				...textRevealVisible,
				duration: 0.5,
				ease: "power2.out",
				stagger: { amount: 0.6 },
			});
			formRevealTrigger = timeline.scrollTrigger ?? null;
		});
	}

	document.addEventListener("astro:page-load", initInquireFormReveal);
	document.addEventListener("astro:before-swap", () => {
		formRevealTrigger?.kill();
		formRevealTrigger = null;
	});


	let clockInterval: ReturnType<typeof setInterval> | null = null;

	function startBrazilClock() {
		if (clockInterval) clearInterval(clockInterval);
		const el = document.getElementById("brazil-clock");
		if (!el) return;

		const formatter = new Intl.DateTimeFormat("en-GB", {
			timeZone: "America/Sao_Paulo",
			hour: "2-digit",
			minute: "2-digit",
			hour12: false,
		});
		const update = () => {
			el.textContent = formatter.format(new Date());
		};
		update();
		clockInterval = setInterval(update, 1000);
	}

	document.addEventListener("astro:page-load", startBrazilClock);
	document.addEventListener("astro:before-swap", () => {
		if (clockInterval) clearInterval(clockInterval);
		clockInterval = null;
	});

	// Writes (or clears) an error message right after whatever it belongs
	// to — a field's own box or the scope fieldset as a whole. Takes a key
	// under "errors" in inquire-i18n.json (kept on the element as
	// data-i18n, so switching language retranslates it). Passing `null`
	// clears it. Reusing the same element on repeat calls keeps this
	// idempotent, so it's safe to call on every input/change.
	function setFieldError(container: Element | null, errorKey: string | null) {
		if (!container) return;
		let el = container.querySelector<HTMLElement>(":scope > .field-error");
		if (errorKey) {
			if (!el) {
				el = document.createElement("p");
				el.className = "field-error";
				// Astro's scoped styles work by stamping a per-component
				// data-astro-cid-* attribute onto every element in the
				// template at build time, and scoping each CSS rule to match
				// it — an element created here in JS never gets one, so its
				// class alone wouldn't be enough to match .field-error's
				// (scoped) rule without copying the attribute from a sibling
				// that already has it.
				for (const attr of Array.from(container.attributes)) {
					if (attr.name.startsWith("data-astro-cid-")) {
						el.setAttribute(attr.name, attr.value);
					}
				}
				container.appendChild(el);
			}
			el.dataset.i18n = `errors.${errorKey}`;
			el.textContent = tr(el.dataset.i18n);
		} else {
			el?.remove();
		}
	}

	// Fades the form out, then plays the same letter-spin reveal used for
	// the site's hero headings on the success message underneath it — the
	// form is still in the DOM (just invisible), which is what keeps the
	// success message centered in the same spot rather than the page
	// reflowing to fill the gap.
	function playSuccessReveal(successEl: HTMLElement) {
		// Selected by class, not tag — so this doesn't silently stop working
		// again if the heading level changes for semantic/SEO reasons.
		const heading = successEl.querySelector<HTMLElement>(".inquire-success-heading");
		const subtext = successEl.querySelector<HTMLElement>(".inquire-success-subtext");
		if (!heading || !subtext) return;

		const letters = splitIntoLetterSpans(heading);
		gsap.set(letters, textRevealHidden());
		gsap.set(subtext, textRevealHidden());

		successEl.removeAttribute("aria-hidden");
		successEl.classList.add("active");

		gsap
			.timeline()
			.to(successEl, { ...textRevealVisible, duration: 0.3, ease: "power2.out" })
			.to(
				letters,
				{
					...textRevealVisible,
					duration: 0.5,
					ease: "power3.out",
					stagger: { amount: 0.4 },
				},
				"-=0.1",
			)
			.to(subtext, { ...textRevealVisible, duration: 0.5, ease: "power2.out" }, ">");
	}

	function showSuccess(form: HTMLFormElement, successEl: HTMLElement) {
		gsap.to(form, {
			opacity: 0,
			duration: 0.4,
			ease: "power2.out",
			onComplete: () => {
				form.classList.add("is-hidden");
				// The reset (clearing values, dropping error messages) only
				// happens once the form is actually faded out and hidden —
				// doing it earlier would flash the fields empty for a beat
				// while they're still visible, mid-fade.
				form.reset();
				form.querySelectorAll(".field-error").forEach((el) => el.remove());
				playSuccessReveal(successEl);
			},
		});
	}

	function bindInquiryForm() {
		const form = document.getElementById(
			"inquiry-form",
		) as HTMLFormElement | null;
		const submitBtn = document.getElementById(
			"inquiry-submit-btn",
		) as HTMLButtonElement | null;
		const status = document.getElementById("inquiry-status");
		const success = document.getElementById("inquiry-success");
		if (!form || !submitBtn || !status || !success || form.dataset.bound)
			return;
		form.dataset.bound = "true";

		// Status keys go through data-i18n like everything else, so a
		// shown message retranslates on a language switch; a raw
		// (untranslatable) server message is written as-is.
		const setStatus = (key: string | null, isError = false, raw = "") => {
			status.classList.toggle("error", isError);
			if (key) {
				status.dataset.i18n = key;
				status.textContent = tr(key);
			} else {
				delete status.dataset.i18n;
				status.textContent = raw;
			}
		};

		const turnstileContainer = document.getElementById("inquiry-turnstile");
		turnstile?.remove();
		turnstile =
			turnstileContainer && form.dataset.turnstileSitekey
				? mountTurnstile(turnstileContainer, form.dataset.turnstileSitekey)
				: null;

		// Some browsers restore previously typed values on a hard refresh
		// (and the status text/error messages from a prior fill), so every
		// time this page is shown — first load, refresh, or navigating back
		// to it — it starts from a genuinely blank form. That includes a
		// prior success: the form itself comes back too, not the message.
		form.reset();
		setStatus(null);
		form.querySelectorAll(".field-error").forEach((el) => el.remove());
		gsap.set(form, { opacity: 1 });
		form.classList.remove("is-hidden");
		gsap.set(success, textRevealHidden());
		success.classList.remove("active");
		success.setAttribute("aria-hidden", "true");
		// Every plain input/select/textarea in the form is required — one
		// generic check (via the browser's own constraint validation, native
		// popup suppressed by novalidate on the form) covers all of them
		// instead of a bespoke function per field.
		const requiredFields = Array.from(
			form.querySelectorAll<HTMLInputElement>(".field [required]"),
		);
		const validateField = (el: HTMLInputElement) => {
			const box = el.closest(".field");
			if (el.validity.valueMissing) {
				setFieldError(box, "required");
				return false;
			}
			if (el.validity.typeMismatch) {
				setFieldError(box, "invalidEmail");
				return false;
			}
			setFieldError(box, null);
			return true;
		};
		requiredFields.forEach((el) => {
			el.addEventListener(
				el.tagName === "SELECT" ? "change" : "input",
				() => validateField(el),
			);
		});

		// Scope isn't marked on individual checkboxes (there's no native
		// "at least one of this group" validity) — at least one of them has
		// to be checked, or the message goes at the end of the fieldset as a
		// whole rather than on any one option.
		const scopeField = form.querySelector(".scope-field");
		const validateScope = () => {
			const anyChecked = !!form.querySelector<HTMLInputElement>(
				'input[name="scope"]:checked',
			);
			setFieldError(
				scopeField,
				anyChecked ? null : "scopeRequired",
			);
			return anyChecked;
		};

		form.querySelectorAll<HTMLInputElement>('input[name="scope"]').forEach(
			(cb) =>
				cb.addEventListener("change", validateScope),
		);

		form.addEventListener("submit", async (e) => {
			e.preventDefault();

			const fieldsValid = requiredFields
				.map(validateField)
				.every(Boolean);
			const validScope = validateScope();
			if (!fieldsValid || !validScope) return;

			submitBtn.disabled = true;
			setStatus("sending");

			const formData = new FormData(form);
			const scope = formData.getAll("scope");
			const payload: Record<string, unknown> = Object.fromEntries(
				[...formData.entries()].filter(
					// Turnstile's own hidden input — the token is sent explicitly below.
					([key]) => key !== "scope" && key !== "cf-turnstile-response",
				),
			);
			payload.scope = scope;
			payload.turnstileToken = (await turnstile?.getToken()) ?? "";

			try {
				const res = await fetch("/api/inquiry", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(payload),
				});
				const data = (await res.json().catch(() => ({}))) as {
					error?: string;
					code?: string;
				};

				if (!res.ok) {
					// Known API codes are translated; anything else shows the
					// server's own (English) message as-is.
					const key = data.code && `errors.${data.code}`;
					if (key && tr(key, "en") !== key) setStatus(key, true);
					else if (data.error) setStatus(null, true, data.error);
					else setStatus("errors.generic", true);
					return;
				}

				setStatus(null);
				showSuccess(form, success);
			} catch {
				// Network failure (fetch itself threw).
				setStatus("errors.generic", true);
			} finally {
				submitBtn.disabled = false;
