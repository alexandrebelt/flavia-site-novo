---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { resolveSocialUrl } from "../data/social-links";

// Link-in-bio page (Instagram etc.). Deliberately not linked from the site's
// own navigation, not in the sitemap and not indexed — it's only reached
// from the bio link. The home hero's letters open it, inverted for the
// black background.
const letterModules = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/hero-letters/*.{png,jpg,jpeg,webp,svg,avif}",
	{ eager: true },
);

const letters = Object.entries(letterModules)
	.sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
	.map(([path, mod]) => ({
		src: mod.default,
		alt:
			path
				.split("/")
				.pop()
				?.replace(/\.[^.]+$/, "") ?? "",
	}));

// admin › Settings › SEO.
const { seo } = await Astro.locals.siteSettings();

const links = [
	{ label: "Start your brand", href: "/services" },
	{ label: "Book now", href: "/inquire" },
	{ label: "Portfolio", href: "/portfolio" },
	{ label: "Behance", href: resolveSocialUrl("behance", seo.socialLinks), external: true },
	{ label: "Instagram", href: resolveSocialUrl("instagram", seo.socialLinks), external: true },
];
---

<Layout title="Links" noindex bare>
	<section class="links-section">
		<div class="links-wrapper">
			<a href="/" class="links-logo" aria-label="Flávia Jackeline — Home">
				<span class="links-logo-letters">
					{
						letters.map((letter) => (
							<Image src={letter.src} alt="" class="links-letter" />
						))
					}
				</span>
			</a>
			<h6 class="links-tagline">
				creating refined identities for thoughtful brands. minimal,
				strategic, and quietly distinctive.
			</h6>
			<nav class="links-list" aria-label="Links">
				{
					links.map((link) => (
						<a
							href={link.href}
							class="btn-secondary links-button"
							{...(link.external && { target: "_blank", rel: "noopener noreferrer" })}
						>
							{link.label}
						</a>
					))
				}
			</nav>
		</div>
	</section>
</Layout>

<script>
	import gsap from "gsap";
	import { textRevealHidden, textRevealVisible } from "../scripts/text-reveal";
	import { onPageReady } from "../scripts/page-ready";

	// Same entrance as the home hero (index.astro's playHeroReveal): the
	// letters blur in one by one, then the tagline, then the buttons.
	function playLinksReveal() {
		const letters = document.querySelectorAll<HTMLElement>(".links-letter");
		const tagline = document.querySelector<HTMLElement>(".links-tagline");
		const buttons = document.querySelectorAll<HTMLElement>(".links-button");
		if (!letters.length || !tagline) return;

		// Hidden immediately so nothing flashes before the page fade ends.
		gsap.set(letters, textRevealHidden());
		gsap.set([tagline, ...buttons], textRevealHidden());

		function enableHoverTilt() {
			letters.forEach((letter) => {
				letter.addEventListener("mouseenter", () => {
					gsap.killTweensOf(letter);
					gsap.timeline()
						.to(letter, { rotateY: -14, duration: 0.18, ease: "power2.out" })
						.to(letter, { rotateY: 0, duration: 0.4, ease: "back.out(2.5)" });
				});
			});
		}

		onPageReady(() => {
			gsap.to(letters, {
				...textRevealVisible,
				duration: 0.9,
				ease: "power3.out",
				stagger: 0.12,
				onComplete: enableHoverTilt,
			});
			gsap.to(tagline, { ...textRevealVisible, duration: 1, delay: 1 });
			gsap.to(buttons, {
				...textRevealVisible,
				duration: 0.6,
				ease: "power2.out",
				delay: 1.3,
				stagger: 0.1,
			});
		});
	}

	document.addEventListener("astro:page-load", playLinksReveal);
</script>

<style>
	.links-section {
		min-height: 100vh;
		min-height: 100dvh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 4rem var(--padding-sides);
	}

	.links-wrapper {
		width: 100%;
		max-width: 420px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.5rem;
	}

	/* The letter PNGs are dark; inverting their wrapper turns them light
	   for the black background. Kept on the wrapper, not the letters, since
	   the reveal animates each letter's own `filter` (blur). */
	.links-logo {
		display: block;
		filter: invert(1);
	}

	.links-logo-letters {
		--links-letter-aspect-sum: 2.4755;
		--links-fourth-scale: 1.24;
		--links-letter-h: calc(min(80vw, 380px) / var(--links-letter-aspect-sum));
		display: flex;
		align-items: flex-start;
		justify-content: center;
		gap: clamp(0.25rem, 1vw, 0.5rem);
		perspective: 1200px;
	}

	.links-letter {
		height: auto;
		width: auto;
		max-height: var(--links-letter-h);
		opacity: 0;
		backface-visibility: hidden;
	}

	/* Same optical spacing/scale tweaks as the home hero. */
	.links-letter:nth-of-type(3) {
		margin-left: -6%;
		margin-right: -0.5%;
	}

	.links-letter:nth-of-type(4) {
		max-height: calc(var(--links-letter-h) * var(--links-fourth-scale));
	}

	.links-tagline {
		max-width: 320px;
		margin: 0 0 1rem;
		opacity: 0;
	}

	.links-list {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	/* Full-width outlined buttons, light on black — the global
	   .bg-black .btn-secondary colours, applied here since the page's
	   black comes from the body, not a .bg-black section. */
	.links-button {
		--btn-fill-color: var(--color-offwhite);
		--btn-fill-text-color: var(--color-black);
		width: 100%;
		padding: 0.9em 1.5em;
		text-align: center;
		color: var(--color-offwhite);
		border-color: var(--color-offwhite);
		opacity: 0;
		transition: color 0.4s ease;
	}

	/* The light color above outranks the global .btn-secondary:hover, so
	   the text would vanish into the light fill — flip it here too. */
	.links-button:hover,
	.links-button:focus-visible {
		color: var(--color-black);
	}
</style>
