---
import Layout from "../layouts/Layout.astro";
import HeroFlavia from "../assets/flavia-jackeline2.webp";
import ExperiencesText from "../components/ExperiencesText.astro";
import CtaInquire from "../components/CtaInquire.astro";
import { resolveSocialUrl } from "../data/social-links";
import { normalizeRecognitions } from "../data/recognitions";

// Admin overrides (About) — empty fields keep the bundled defaults. The
// social links are the same admin-set URLs as the footer's "Connect" ones.
const { about, seo } = await Astro.locals.siteSettings();
const socialLinks = seo.socialLinks;
// Each item links out only when the admin gave it a link; otherwise it's plain text.
const recognitions = normalizeRecognitions(about.recognitions);
---

<Layout
	title="About"
	description="Founded by Brazilian designer Flávia Jackeline, the studio has developed more than 150 brand identity projects for clients across 13+ countries."
>
	<section class="full-height hero-about-section">
		<div class="hero-about-wrapper">
			<img
				id="about-hero-img"
				src={about.heroImageUrl || HeroFlavia.src}
				alt="Flávia Jackeline"
			/>
			<div class="hero-about-section-row row limit">
				<div class="hero-about-phrase hero-about-phrase--name">
					<span>Flavia jackeline <br />Brand Designer</span>
				</div>
				<div class="hero-about-phrase hero-about-phrase--tagline">
					<span>Creating refined identities<br />for thoughtful brands.</span>
				</div>
				<div class="hero-about-phrase hero-about-phrase--approach">
					<span>Minimal, strategic, <br />and quietly distinctive.</span>
				</div>
				<div class="hero-about-phrase hero-about-phrase--location">
					<span>Based in Brazil<br />working worldwide.</span>
				</div>
			</div>
		</div>
	</section>
	<section class="full-height about-section-2">
		<div class="about-section-2-wrapper limit">
			<div class="about-section-2-row row">
				<div class="about-section-2-col col">
					<h4>
						Flávia Jackeline is an independent Brazilian brand
						studio creating distinctive identities for brands that
						value considered design.
					</h4>
					<div class="about-section-2-contact-row">
						<ul class="about-section-social-media-ul">
							<li><a href="mailto:hello@flaviajackeline.com">Email</a></li>
							<li>
								<a
									href={resolveSocialUrl("instagram", socialLinks)}
									data-social="instagram"
									target="_blank"
									rel="noopener noreferrer">Instagram</a
								>
							</li>
							<li>
								<a
									href={resolveSocialUrl("linkedin", socialLinks)}
									data-social="linkedin"
									target="_blank"
									rel="noopener noreferrer">Linkedin</a
								>
							</li>
							<li>
								<a
									href={resolveSocialUrl("behance", socialLinks)}
									data-social="behance"
									target="_blank"
									rel="noopener noreferrer">Behance</a
								>
							</li>
						</ul>
					</div>
				</div>
				<div class="about-section-2-col col">
					<div class="about-section-2-col-wrapper">
						<p>
							Founded and led by Brazilian designer Flávia
							Jackeline, the studio works with founders and
							businesses across fashion, hospitality, wellness,
							beauty and other design-led industries around the
							world.
						</p>
						<p>
							With a background in Fashion Design, Graphic Design
							and an MBA in Digital Design and Branding, Flávia
							brings a particular sensitivity to typography,
							composition, materiality and detail. This
							multidisciplinary perspective shapes the studio’s
							approach to identity, combining visual refinement
							with thoughtful direction and a strong understanding
							of how brands need to function in the real world.
						</p>
						<p>
							Over seven years, the studio has developed more than
							150 projects for clients across 13+ countries, with
							work recognized by Behance, Best of Behance, the
							World Brand Design Society, Brands On Cue and other
							international design platforms.
						</p>
						<p>
							Every project is led personally by Flávia from
							initial direction through final delivery, with
							trusted collaborators brought in only when the scope
							calls for it.
						</p>
					</div>
				</div>
			</div>
			<div class="about-section-2-row row">
				<ExperiencesText />
			</div>
		</div>
	</section>
	<section class="full-height about-section-3 bg-black">
		<div class="about-section-3-wrapper limit">
			<div class="about-section-3-row row">
				<div class="about-section-3-col col">
					<h6>SELECTED RECOGNITION</h6>
				</div>
				<div class="about-section-3-col col">
					<ul id="about-recognitions-list">
						{recognitions.map(({ text, url }) => (
							<li>
								{url ? (
									<a href={url} target="_blank" rel="noopener noreferrer">
										{text}
									</a>
								) : (
									text
								)}
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>
	<CtaInquire />
</Layout>

<script>
	import gsap from "gsap";
	import { textRevealHidden, textRevealVisible } from "../scripts/text-reveal";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { splitIntoLetterSpans, splitPreservingMarkup } from "../scripts/hero-letter-reveal";
	import { whenPageSettled } from "../scripts/scroll-timing";
	import { onPageReady } from "../scripts/page-ready";

	gsap.registerPlugin(ScrollTrigger);

	function playHeroAboutReveal() {
		const spans = document.querySelectorAll<HTMLElement>(
			".hero-about-phrase > span",
		);
		if (!spans.length) return;

		// Each span's own letters, split in document order — the timeline
		// below reveals them span by span (first span's letters spin in,
		// then the second's, and so on), not all four at once.
		const spanLetters = Array.from(spans).map((span) => splitPreservingMarkup(span));
		const allLetters = spanLetters.flat();
		gsap.set(allLetters, textRevealHidden());

		// Waits for the page-entrance transition to actually finish (see
		// Layout.astro) — running immediately on astro:page-load instead
		// would play this out mostly hidden during the fade.
		onPageReady(() => {
			const timeline = gsap.timeline();
			spanLetters.forEach((letters, i) => {
				timeline.to(
					letters,
					{
						...textRevealVisible,
						duration: 0.6,
						ease: "power3.out",
						stagger: { amount: 0.5 },
					},
					i === 0 ? undefined : ">",
				);
			});
		});
	}

	// Fires right as the page swaps in — playHeroAboutReveal hides the
	// letters synchronously at that point (before the fade has painted
	// anything) and only starts actually animating them once
	// astro:page-ready fires, once the page-entrance transition is done.
	document.addEventListener("astro:page-load", playHeroAboutReveal);

	// Pinned + scrubbed, one continuous sequence: heading letters spin in,
	// then the social-media list items fade in one by one, then the bio
	// paragraphs fade in one by one, and finally the achievements line
	// (shared with the homepage) spins in the same way as the heading.
	let aboutSection2Trigger: ScrollTrigger | null = null;
	let aboutSection2Mm: gsap.MatchMedia | null = null;

	function buildAboutSection2Timeline() {
		aboutSection2Trigger?.kill();
		aboutSection2Trigger = null;
		aboutSection2Mm?.revert();
		aboutSection2Mm = null;

		const heading = document.querySelector<HTMLElement>(".about-section-2-col h4");
		const socialItems = document.querySelectorAll<HTMLElement>(
			".about-section-social-media-ul li",
		);
		const paragraphs = document.querySelectorAll<HTMLElement>(
			".about-section-2-col-wrapper p",
		);
		if (!heading || !socialItems.length || !paragraphs.length) return;

		const headingLetters = splitIntoLetterSpans(heading);
		gsap.set(headingLetters, textRevealHidden());
		gsap.set(socialItems, textRevealHidden());
		gsap.set(paragraphs, textRevealHidden());

		// The achievements line (shared with the homepage) is the last part
		// of this same pinned sequence.
		const experiencesEl = document.getElementById("experiences-text-content");
		const experiencesLetters = experiencesEl ? splitIntoLetterSpans(experiencesEl) : [];
		if (experiencesLetters.length) {
			gsap.set(experiencesLetters, textRevealHidden());
		}

		// Pinned on desktop — created immediately (not deferred), so its
		// scroll space is reserved before the user can start scrolling
		// instead of being inserted underneath them mid-scroll. Below 886px
		// the content collapses to a single column, so pinning would just
		// hold a tall column on screen for way too long a scroll — instead
		// it plays unpinned, scrubbed to the section's own scroll passage.
		const mm = gsap.matchMedia();
		mm.add(
			{ isDesktop: "(min-width: 886px)", isMobile: "(max-width: 885px)" },
			(context) => {
				const { isDesktop } = context.conditions as { isDesktop: boolean };

				const timeline = gsap.timeline({
					scrollTrigger: {
						trigger: ".full-height.about-section-2",
						start: isDesktop ? "top top" : "top 65%",
						end: isDesktop ? "+=2500" : "bottom bottom",
						pin: isDesktop,
						pinSpacing: isDesktop,
						scrub: isDesktop ? true : 0.8,
						anticipatePin: isDesktop ? 1 : 0,
					},
				});

				timeline
					.to(headingLetters, { ...textRevealVisible, stagger: { amount: 0.5 } })
					.to(socialItems, { ...textRevealVisible, stagger: { amount: 0.3 } }, ">")
					.to(paragraphs, { ...textRevealVisible, stagger: { amount: 0.4 } }, ">");
				if (experiencesLetters.length) {
					timeline.to(
						experiencesLetters,
						{ ...textRevealVisible, stagger: { amount: 0.5 } },
						">",
					);
				}

				aboutSection2Trigger = timeline.scrollTrigger ?? null;
			},
		);

		aboutSection2Mm = mm;
	}

	function initAboutSection2Reveal() {
		buildAboutSection2Timeline();
	}

	document.addEventListener("astro:page-load", initAboutSection2Reveal);

	let aboutSection3Trigger: ScrollTrigger | null = null;

	function initAboutSection3Reveal() {
		aboutSection3Trigger?.kill();
		aboutSection3Trigger = null;

		const cols = document.querySelectorAll<HTMLElement>(".about-section-3-col");
		if (!cols.length) return;

		gsap.set(cols, textRevealHidden());

		whenPageSettled(() => {
			const timeline = gsap.timeline({
				scrollTrigger: {
					trigger: ".about-section-3",
					start: "top 80%",
					toggleActions: "play none none reverse",
				},
			});
			timeline.to(cols, {
				...textRevealVisible,
				duration: 0.6,
				ease: "power2.out",
				stagger: { amount: 0.4 },
			});
			aboutSection3Trigger = timeline.scrollTrigger ?? null;
		});
	}

	document.addEventListener("astro:page-load", initAboutSection3Reveal);

	document.addEventListener("astro:before-swap", () => {
		aboutSection2Trigger?.kill();
		aboutSection2Trigger = null;
		aboutSection2Mm?.revert();
		aboutSection2Mm = null;
		aboutSection3Trigger?.kill();
		aboutSection3Trigger = null;
	});

</script>

<style is:global>
	.hero-about-section {
		max-height: 100vh;
		overflow: hidden;
		position: relative;
	}
	.hero-about-wrapper {
		width: 100%;
	}
	.hero-about-section img {
		width: 100vw;
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		z-index: 1;
	}
	.hero-about-section-row {
		position: relative;
		z-index: 2;
		width: 100%;
		display: flex;
		align-self: stretch;
		justify-content: space-between;
	}
	.hero-about-section-row span {
		color: var(--color-offwhite);
		text-transform: uppercase;
	}
	.hero-about-phrase--name,
	.hero-about-phrase--location {
		font-weight: 500;
	}
	.about-section-2-row.row {
		justify-content: space-between;
	}

	.about-section-2-contact-row ul {
		flex-direction: row;
		display: flex;
		gap: 1.2rem;
		padding: 0;
		text-transform: uppercase;
		font-size: 10px;
		padding-top: 2em;
	}
	.about-section-2-contact-row li {
		align-content: center !important;
		justify-content: center;
		display: flex;
	}
	.about-section-2-col:nth-of-type(1) {
		max-width: clamp(46ch, 35vw, 53ch);
	}
	.about-section-2-col:nth-of-type(2) {
		max-width: 57ch;
	}
	.about-section-2-contact-row a {
		color: inherit;
		text-decoration: none;
	}
	.about-section-2-contact-row li::before {
		content: "●";
		margin-right: 8px;
	}
	.about-section-2-wrapper.limit {
		display: flex;
		flex-direction: column;
		align-self: stretch;
		justify-content: space-between;
	}
	.about-section-3-row.row h6 {
		letter-spacing: 0.05em;
	}
	.full-height.about-section-3 {
		align-items: baseline;
	}
	.about-section-3-row.row {
		justify-content: space-between;
	}
	#about-recognitions-list li {
		display: flex;
		border-bottom: 1px solid rgba(255, 255, 255, 0.6);
		width: fit-content;
		margin-bottom: 3px;
	}
	#about-recognitions-list a {
		color: inherit;
		text-decoration: none;
		transition: opacity 0.3s ease;
	}
	#about-recognitions-list a:hover {
		opacity: 0.6;
	}

	@media (max-width: 885px) {
		.hero-about-section-row.row.limit {
			flex-direction: column;
			gap: 1rem;
		}
		.hero-about-section-row span {
			font-size: clamp(10px, 1.8vw, 16px) !important;
		}
		.hero-about-wrapper img {
			height: 100%;
			object-fit: cover;
		}
		.about-section-2-row {
			flex-direction: column;
			gap: 3rem;
		}
		.about-section-2-col:nth-of-type(2) {
			max-width: 100% !important;
		}
		.about-section-2-col.col {
			max-width: 100%;
		}
		.about-section-3-row.row {
			flex-direction: column;
		}
		.about-section-3-row.row ul {
			padding: 0;
			padding-top: 1rem;
		}
		.full-height.about-section-3 {
			min-height: auto;
		}
	}
</style>
