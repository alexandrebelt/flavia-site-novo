---
// Set in the admin (Home › achievements text); rendered per request.
const { home } = await Astro.locals.siteSettings();
---

<div class="experiences-text">
	<h5 id="experiences-text-content">{home.achievementsText}</h5>
</div>
<style>
	.experiences-text {
		margin: 0 auto !important;
		text-align: center;
		padding-top: 3rem;
	}
</style>
