---
interface Props {
	title: string;
	intro?: string;
}

const { title, intro } = Astro.props;
---

<section class="page">
	<header class="page-head">
		<h1>{title}</h1>
		{intro && <p class="intro">{intro}</p>}
	</header>

	<div class="page-body">
		<slot />
	</div>
</section>

<style>
	.page {
		max-width: 100%;
		margin: 0 auto;
		padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 4vw, 3rem);
	}

	.page-head h1 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 600;
	}

	.intro {
		margin: 0.75rem 0 0;
		max-width: 60ch;
		color: #555;
		font-size: 1.05rem;
		line-height: 1.6;
	}

	.page-body {
		margin-top: 2.5rem;
	}
</style>
