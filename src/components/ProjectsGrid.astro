---
import { PROJECTS_PAGE_SIZE, projectCover } from "../lib/server/site-data";

interface Props {
	/** Show only the first N projects plus a "View all" link (the home page). */
	limit?: number;
	/**
	 * Show every project, PROJECTS_PAGE_SIZE at a time: the first page is
	 * rendered here and the rest are lazy-loaded from /partials/projects as
	 * the visitor scrolls (the portfolio page).
	 */
	paginate?: boolean;
	/** First project to render — used by /partials/projects for later pages. */
	offset?: number;
}

const { limit, paginate = false, offset = 0 } = Astro.props;
// Managed in the admin (Projetos), stored in D1, in the admin's chosen
// order with featured projects first (see orderProjects).
const projects = await Astro.locals.projects();

const pageSize = limit ?? (paginate ? PROJECTS_PAGE_SIZE : projects.length);
const visibleProjects = projects.slice(offset, offset + pageSize);
const nextOffset =
	paginate && offset + pageSize < projects.length ? offset + pageSize : null;
const showViewAll = typeof limit === "number";
---

{
	visibleProjects.length === 0 && offset === 0 ? (
		<p class="empty">Projects will be added here soon.</p>
	) : (
		<ul class="project-list">
			{visibleProjects.map((project, i) => (
				<li class="project-item">
					<a
						class="project-row row"
						href={`/portfolio/${project.slug}`}
					>
						<div class="project-col project-col--index col">
							<span class="project-number">
								{String(offset + i + 1).padStart(2, "0")}
							</span>
							<h4>{project.client}</h4>
						</div>

						<div class="project-col project-col--media col">
							{projectCover(project) && (
								<img
									src={projectCover(project)}
									alt={project.client}
									loading="lazy"
									decoding="async"
								/>
							)}
						</div>

						<div class="project-col project-col--meta col">
							<span class="project-year">{project.year}</span>
							<p class="project-tags">
								{[project.category, ...project.tags].join(", ")}
							</p>
						</div>
					</a>
				</li>
			))}
			{nextOffset !== null && (
				<li
					class="project-list-sentinel"
					data-next-offset={nextOffset}
					aria-hidden="true"
				/>
			)}
		</ul>
	)
}

{
	showViewAll && (
		<div class="project-list-footer">
			<a href="/portfolio" class="btn-primary">
				View all projects
			</a>
		</div>
	)
}

<style>
	.empty {
		color: var(--color-gray);
		font-size: 1.05rem;
	}

	.project-list {
		margin: 0;
		padding: 0;
		list-style: none;
		padding-top: 6rem;
	}

	.project-row {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		flex-wrap: wrap;
		row-gap: 1rem;
		border-top: 1px solid var(--color-dark-gray);
		color: inherit;
		text-decoration: none;
	}

	.project-list .project-item:last-child .project-row {
		border-bottom: 1px solid var(--color-dark-gray);
	}

	.project-col {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		/* flex items default to min-width: auto, which blocks shrinking
		   below the content's natural width — that's what was pushing
		   these columns (and their text) past the viewport instead of
		   wrapping/shrinking. */
		min-width: 0;
	}

	.project-col--index {
		flex: 1 1 12rem;
		padding-top: 2em;
	}
	.project-col--index h4 {
		margin: 0;
	}
	.project-col--media {
		flex: 1 1 14rem;
	}

	.project-col--meta {
		flex: 1 1 12rem;
		text-transform: uppercase;
		align-self: center;
		padding-left: clamp(0px, 4vw, 5rem);
	}

	.project-number {
		font-size: var(--font-size-h6);
		color: var(--color-gray);
	}

	.project-col--index h3 {
		margin: 0;
	}

	.project-col--media img {
		width: 100%;
		aspect-ratio: 36/20;
		object-fit: cover;
		height: auto;
		display: block;
	}

	.project-year {
		font-size: var(--font-size-h6);
		color: var(--color-gray);
	}

	.project-tags {
		margin: 0;
		color: var(--color-gray);
		overflow-wrap: anywhere;
		font-size: 13px;
	}

	.project-list-sentinel {
		list-style: none;
		height: 1px;
	}

	.project-list-footer {
		display: flex;
		justify-content: flex-end;
		padding-top: 2rem;
	}

	@media (max-width: 800px) {
		.project-list {
			padding-top: 3rem !important;
		}
	}
	@media (max-width: 667px) {
		.project-list-footer {
			justify-content: center !important;
		}
		.project-col.project-col--media.col {
			order: 3;
			padding-bottom: 5rem;
		}
		.project-col.project-col--index.col {
			padding-top: 1rem;
		}
		.project-col.project-col--meta.col {
			align-self: auto;
			padding-top: 1rem;
		}
	}
	@media (max-width: 462px) {
		.project-col.project-col--meta.col {
			padding-left: 0;
			padding-top: 1rem;
		}
	}
</style>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { splitIntoLetterSpans } from "../scripts/hero-letter-reveal";
	import { refreshScrollTriggers, whenPageSettled } from "../scripts/scroll-timing";

	gsap.registerPlugin(ScrollTrigger);

	let triggers: ScrollTrigger[] = [];
	let observer: IntersectionObserver | null = null;
	let loadController: AbortController | null = null;

	interface PreparedItem {
		item: HTMLElement;
		row: HTMLElement;
		number: HTMLElement;
		letters: HTMLElement[];
		meta: HTMLElement;
	}

	// Hides each item's parts (immediately, so nothing flashes fully
	// visible before its reveal exists) and splits its title into letters.
	function prepareItems(items: Iterable<HTMLElement>): PreparedItem[] {
		const prepared: PreparedItem[] = [];
		for (const item of items) {
			const row = item.querySelector<HTMLElement>(".project-row");
			const number = item.querySelector<HTMLElement>(".project-number");
			const title = item.querySelector<HTMLElement>(".project-col--index h4");
			const meta = item.querySelector<HTMLElement>(".project-col--meta");
			if (!row || !number || !title || !meta) continue;

			gsap.set(row, { opacity: 0 });
			gsap.set(number, { opacity: 0 });
			gsap.set(meta, { opacity: 0 });
			const letters = splitIntoLetterSpans(title);
			gsap.set(letters, { rotateY: -90, opacity: 0, transformPerspective: 400 });

			prepared.push({ item, row, number, letters, meta });
		}
		return prepared;
	}

	function createTriggers(prepared: PreparedItem[]) {
		prepared.forEach(({ item, row, number, letters, meta }) => {
			// The item fades in with its own eased duration as it enters the
			// viewport, instead of snapping opacity directly to scroll
			// position (which read as an abrupt, scroll-scrubbed cut rather
			// than a fade).
			const settle = gsap.fromTo(
				row,
				{ opacity: 0 },
				{
					opacity: 1,
					duration: 0.8,
					ease: "power2.out",
					scrollTrigger: {
						trigger: item,
						start: "top 95%",
						toggleActions: "play none none reverse",
					},
				},
			);
			if (settle.scrollTrigger) triggers.push(settle.scrollTrigger);

			// Once settled, the number/title/meta reveal in sequence — this
			// part plays on its own timeline (not scrubbed) so the letters
			// actually have time to visibly spin in, triggered late enough
			// (deep into the viewport) that it still has room to play before
			// the item scrolls past.
			const detail = gsap.timeline({
				scrollTrigger: {
					trigger: item,
					start: "top 85%",
					toggleActions: "play none none reverse",
				},
			});
			detail
				.to(number, { opacity: 1, duration: 0.4, ease: "power2.out" })
				.to(
					letters,
					{
						rotateY: 0,
						opacity: 1,
						duration: 0.5,
						ease: "power3.out",
						stagger: { amount: 0.3 },
					},
					"-=0.1",
				)
				.to(meta, { opacity: 1, duration: 0.5, ease: "power2.out" }, "-=0.1");
			if (detail.scrollTrigger) triggers.push(detail.scrollTrigger);
		});
	}

	// Portfolio lazy loading: when the sentinel left after the last rendered
	// project nears the viewport, the next page of items is fetched from
	// /partials/projects (rendered by this same component, so the markup and
	// scoped styles match), swapped in for the sentinel — which brings the
	// next sentinel along, if there are more — and revealed like the rest.
	function observeSentinel() {
		const sentinel = document.querySelector<HTMLElement>(".project-list-sentinel");
		if (!sentinel) return;
		observer ??= new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) loadMore(entry.target as HTMLElement);
				}
			},
			{ rootMargin: "600px 0px" },
		);
		observer.observe(sentinel);
	}

	async function loadMore(sentinel: HTMLElement) {
		if (sentinel.dataset.loading) return;
		sentinel.dataset.loading = "true";
		observer?.unobserve(sentinel);

		loadController = new AbortController();
		try {
			const res = await fetch(`/partials/projects?offset=${sentinel.dataset.nextOffset}`, {
				signal: loadController.signal,
			});
			if (!res.ok) throw new Error(`HTTP ${res.status}`);
			const doc = new DOMParser().parseFromString(await res.text(), "text/html");
			const newNodes = Array.from(doc.querySelectorAll<HTMLElement>(".project-list > li"));
			sentinel.replaceWith(...newNodes);

			const newItems = newNodes.filter((node) => node.classList.contains("project-item"));
			createTriggers(prepareItems(newItems));
			refreshScrollTriggers();
			observeSentinel();
		} catch (err) {
			if ((err as Error).name === "AbortError") return;
			console.error("Couldn't load more projects:", err);
			// Let a later scroll past it try again.
			delete sentinel.dataset.loading;
			observer?.observe(sentinel);
		}
	}

	function initProjectGridReveal() {
		cleanupProjectGridReveal();

		const prepared = prepareItems(
			document.querySelectorAll<HTMLElement>(".project-list .project-item"),
		);

		// This script can run before the homepage's own pinned section
		// (index.astro's section 3, which reserves extra scroll space via a
		// ScrollTrigger pin spacer) has been created, or before the hero
		// video/images finish loading and settle the layout below them.
		// Reading "top X%" positions before that bakes in the wrong
		// position, so trigger creation waits until the page has actually
		// settled.
		whenPageSettled(() => {
			createTriggers(prepared);
			observeSentinel();
		});
	}

	function cleanupProjectGridReveal() {
		triggers.forEach((trigger) => trigger.kill());
		triggers = [];
		observer?.disconnect();
		observer = null;
		loadController?.abort();
		loadController = null;
	}

	document.addEventListener("astro:page-load", initProjectGridReveal);
	document.addEventListener("astro:before-swap", cleanupProjectGridReveal);
</script>
