---
import FooterLogo from "../assets/footer-logo.png";
import { SOCIAL_NETWORKS, resolveSocialUrl } from "../data/social-links";
const year = new Date().getFullYear();

const navLinks = [
	{ href: "/services", label: "Services" },
	{ href: "/about", label: "About" },
	{ href: "/portfolio", label: "Portfolio" },
	{ href: "/inquire", label: "Inquire" },
];

// Set in the admin (Configurações › SEO); rendered per request.
const { seo } = await Astro.locals.siteSettings();
const socialLinks = seo.socialLinks;
const connectLinks = SOCIAL_NETWORKS.map((network) => ({
	label: network.label,
	href: resolveSocialUrl(network.key, socialLinks),
}));

const email = "hello@flaviajackeline.com";
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-cols">
			<div class="footer-col">
				<a href="/" class="brand"
					><img src={FooterLogo.src} alt="Flávia Jackeline" /></a
				>
				<p>
					Creating refined identities for thoughtful brands. Minimal,
					strategic, and quietly distinctive. Based in Brazil, working
					worldwide.
				</p>
			</div>

			<div class="footer-col">
				<h3>Studio</h3>
				<ul>
					{
						navLinks.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="footer-col">
				<h3>Connect</h3>
				<ul>
					{
						connectLinks.map((link) => (
							<li>
								<a
									href={link.href}
									target="_blank"
									rel="noopener noreferrer"
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="footer-col">
				<h3>Email</h3>
				<a href={`mailto:${email}`}>{email}</a>
			</div>
		</div>

		<hr />

		<div class="footer-bottom">
			<p>&copy; {year} Flávia Jackeline. All rights reserved.</p>
			<p>Brand identity for thoughtful brands worldwide.</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-offwhite);
		color: var(--color-black);
	}

	.footer-inner {
		max-width: var(--max-width-page);
		margin: 0 auto;
		padding: 3rem clamp(1rem, 4vw, 3rem);
	}

	.footer-cols {
		display: flex;
		flex-direction: row;
		gap: 11rem;
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		flex: 1 1 180px;
		max-width: fit-content;
	}
	.footer-col:nth-of-type(1) {
		margin-right: auto;
	}

	.footer-col p {
		margin: 0;
		max-width: 34ch;
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.brand {
		font-size: 1.25rem;
		font-weight: 600;
		color: #fff;
		text-decoration: none;
	}
	.brand img {
		max-width: 250px;
	}

	.footer-col h3 {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-black);
	}

	.footer-col ul {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.footer-col a {
		font-size: 0.9rem;
		color: var(--color-black);
		text-decoration: none;
	}

	.footer-col a:hover {
		color: var(--color-black);
	}

	hr {
		border: 0;
		border-top: 1px solid var(--color-black);
		margin: 2.5rem 0 1.5rem;
	}

	.footer-bottom {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.footer-bottom p {
		margin: 0;
		font-size: 0.8rem;
		color: var(--color-black);
	}
	@media (max-width: 1150px) {
		.footer-cols {
			gap: clamp(20px, 8vw, 11rem) !important;
		}
	}
	@media (max-width: 767px) {
		.footer-cols {
			flex-direction: column;
			text-align: center;
			gap: 3rem;
		}
		.footer-col {
			justify-content: center;
			margin: 0 auto;
			flex: auto !important;
		}
		.footer-bottom {
			align-items: center !important;
		}
	}
	@media (max-width: 640px) {
		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { whenPageSettled } from "../scripts/scroll-timing";

	gsap.registerPlugin(ScrollTrigger);

	// Every SPA navigation swaps in a fresh footer node, so, like every other reveal,
	// this re-runs on each astro:page-load and kills its trigger on
	// astro:before-swap; running it only once left every page after the
	// first with a static footer and a trigger pointing at a detached node.
	let footerTrigger: ScrollTrigger | null = null;

	function initFooterReveal() {
		footerTrigger?.kill();
		footerTrigger = null;

		const items = document.querySelectorAll<HTMLElement>(".footer-col > *");
		const hr = document.querySelector<HTMLElement>(".site-footer hr");
		const bottom = document.querySelector<HTMLElement>(".footer-bottom");
		if (!items.length || !hr || !bottom) return;

		gsap.set(items, { opacity: 0 });
		gsap.set(hr, { width: "0%" });
		gsap.set(bottom, { opacity: 0 });

		whenPageSettled(() => {
			const timeline = gsap.timeline({
				scrollTrigger: {
					trigger: ".site-footer",
					start: "top 85%",
					toggleActions: "play none none reverse",
				},
			});
			timeline
				.to(items, {
					opacity: 1,
					duration: 0.5,
					ease: "power2.out",
					// A fixed total spread, not a fixed per-item delay — so it
					// stays snappy (and reverses quickly) regardless of how
					// many links end up in the columns.
					stagger: { amount: 0.5 },
				})
				.to(hr, { width: "100%", duration: 0.6, ease: "power2.out" }, ">")
				.to(bottom, { opacity: 1, duration: 0.5, ease: "power2.out" }, ">");

			footerTrigger = timeline.scrollTrigger ?? null;
		});
	}

	document.addEventListener("astro:page-load", initFooterReveal);
	document.addEventListener("astro:before-swap", () => {
		footerTrigger?.kill();
		footerTrigger = null;
	});
</script>
