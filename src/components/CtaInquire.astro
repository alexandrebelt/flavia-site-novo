<section class="cta-inquire bg-dark-gray">
		<div class="cta-inquire-wrapper limit">
			<div class="cta-inquire-row row">
				<div class="cta-inquire-col col center-content">
					<p>
						The studio takes on a <strong>limited number</strong> of brand identity
						projects each year, working closely with founders who
						see design as part of how their business is built, not
						an afterthought.
					</p>
					<a class="btn-secondary" href="/inquire">
						Inquire
					</a>
				</div>
			</div>
		</div>
	</section>
	<style>

		.cta-inquire-col {
			max-width: 505px;
			text-align: center;
			gap:1em;
		}
	</style>

	<script>
		import gsap from "gsap";
		import { textRevealHidden, textRevealVisible } from "../scripts/text-reveal";
		import { ScrollTrigger } from "gsap/ScrollTrigger";
		import { whenPageSettled } from "../scripts/scroll-timing";

		gsap.registerPlugin(ScrollTrigger);

		let trigger: ScrollTrigger | null = null;

		function initCtaReveal() {
			trigger?.kill();
			trigger = null;

			const p = document.querySelector<HTMLElement>(".cta-inquire-col p");
			const link = document.querySelector<HTMLElement>(".cta-inquire-col a");
			if (!p || !link) return;

			gsap.set([p, link], textRevealHidden());

			whenPageSettled(() => {
				const timeline = gsap.timeline({
					scrollTrigger: {
						trigger: ".cta-inquire-col",
						start: "top 80%",
						toggleActions: "play none none reverse",
					},
				});
				timeline
					.to(p, { ...textRevealVisible, duration: 0.6, ease: "power2.out" })
					.to(link, { ...textRevealVisible, duration: 0.5, ease: "power2.out" }, ">");

				trigger = timeline.scrollTrigger ?? null;
			});
		}

		document.addEventListener("astro:page-load", initCtaReveal);
		document.addEventListener("astro:before-swap", () => {
			trigger?.kill();
			trigger = null;
		});
	</script>