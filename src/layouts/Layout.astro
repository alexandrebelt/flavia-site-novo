---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SOCIAL_NETWORKS, resolveSocialUrl } from '../data/social-links';
import defaultShareImage from '../assets/video-home-poster.jpg';
import { siteOrigin as resolveSiteOrigin } from '../lib/server/site-data';
import '../styles/main.css';
import 'locomotive-scroll/dist/locomotive-scroll.css';

interface Props {
	/** This page's own name ("About", a project's client...). The full
	 *  <title> is "<site title> — <this>", with the site title set in the
	 *  admin (Settings › SEO). */
	title?: string;
	description?: string;
	ogImage?: string;
	noindex?: boolean;
}

const { title: pageTitle, description, ogImage, noindex } = Astro.props;

// Rendered per request from what the admin saved in D1 (see
// lib/server/site-data.ts) — a save there shows up on the next page view,
// and link previews (WhatsApp, LinkedIn, Google) read these tags straight
// from the HTML, without running any JavaScript.
const settings = await Astro.locals.siteSettings();
const seo = settings.seo;
const siteTitle = settings.siteTitle || 'Flávia';
const title = pageTitle ? `${siteTitle} — ${pageTitle}` : siteTitle;

// Canonical and preview URLs have to be absolute.
const siteOrigin = resolveSiteOrigin(settings, Astro.url);
const absoluteUrl = (value: string) => new URL(value, `${siteOrigin}/`).toString();

const metaDescription = description || seo.defaultDescription || '';
const canonicalUrl = absoluteUrl(Astro.url.pathname);
// Every page gets a preview image: its own (a project's cover), else the
// admin's default share image, else the home video's poster frame.
const metaImage = absoluteUrl(ogImage || seo.ogImageUrl || defaultShareImage.src);
const shouldIndex = seo.allowIndexing !== false && !noindex;

// Only the profiles the admin actually filled in — the networks' generic
// homepages say nothing about the studio.
const sameAs = SOCIAL_NETWORKS.map((network) => resolveSocialUrl(network.key, seo.socialLinks)).filter(
	(url) => !SOCIAL_NETWORKS.some((network) => network.defaultUrl === url),
);
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: siteTitle,
	url: siteOrigin,
	image: metaImage,
	...(seo.defaultDescription && { description: seo.defaultDescription }),
	founder: { '@type': 'Person', name: 'Flávia Jackeline', jobTitle: 'Brand Designer' },
	areaServed: 'Worldwide',
	...(sameAs.length && { sameAs }),
};
// Escaped so a "</script>" inside any admin-entered value can't end the tag.
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');

// Astro's built-in "fade" preset crossfades in 180ms — the old and new page
// briefly overlap, and that's not much of a window for the scroll-to-top
// reset (see the client script's astro:before-swap listener) to actually
// settle before the new page becomes visible. This instead fades the old
// page out, then (only once that's fully done) fades the new one in — the
// swap and scroll reset happen right at the start of this, during the old
// page's fade-out, so by the time the new page is revealed it's already
// sitting at the top with nothing left to catch up on. Reuses the
// astroFadeIn/astroFadeOut keyframes the "fade" preset itself uses (built
// into <ClientRouter />, no extra CSS needed here).
const FADE_DURATION_MS = 350;
const fadeOutThenIn = {
	old: {
		name: "astroFadeOut",
		duration: `${FADE_DURATION_MS}ms`,
		easing: "cubic-bezier(0.76, 0, 0.24, 1)",
		fillMode: "both",
	},
	new: {
		name: "astroFadeIn",
		duration: `${FADE_DURATION_MS}ms`,
		delay: `${FADE_DURATION_MS}ms`,
		easing: "cubic-bezier(0.76, 0, 0.24, 1)",
		fillMode: "both",
	},
};
const pageTransition = { forwards: fadeOutThenIn, backwards: fadeOutThenIn };
// Total time the entrance takes to finish becoming fully visible (old page's
// fade-out, then new page's fade-in) — read client-side to hold back
// anything that's meant to be the first thing the visitor actually sees
// (the hero letter reveals) until the page is done fading in, instead of it
// running mostly hidden during the fade and never being seen.
const PAGE_TRANSITION_MS = FADE_DURATION_MS * 2;
---

<!doctype html>
<html lang="en" data-page-transition-ms={PAGE_TRANSITION_MS}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		{settings.siteFaviconUrl ? (
			<link rel="icon" href={settings.siteFaviconUrl} />
		) : (
			<>
				<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
				<link rel="icon" href="/favicon.ico" />
			</>
		)}
		<title>{title}</title>

		{metaDescription && <meta name="description" content={metaDescription} />}
		<meta name="robots" content={shouldIndex ? 'index, follow' : 'noindex, nofollow'} />
		<link rel="canonical" href={canonicalUrl} />
		{seo.googleSiteVerification && (
			<meta name="google-site-verification" content={seo.googleSiteVerification} />
		)}

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content={siteTitle} />
		<meta property="og:title" content={title} />
		{metaDescription && <meta property="og:description" content={metaDescription} />}
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={metaImage} />
		<meta property="og:image:alt" content={title} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{metaDescription && <meta name="twitter:description" content={metaDescription} />}
		<meta name="twitter:image" content={metaImage} />
		{seo.twitterHandle && (
			<meta name="twitter:site" content={`@${seo.twitterHandle.replace(/^@/, '')}`} />
		)}

		<script type="application/ld+json" is:inline set:html={structuredDataJson} />

		<ClientRouter />
	</head>
	<body>
		<Header />
		<main transition:animate={pageTransition}>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<script>
	import LocomotiveScroll from "locomotive-scroll";
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { splitIntoLetterSpans } from "../scripts/hero-letter-reveal";

	gsap.registerPlugin(ScrollTrigger);

	// astro:page-load fires as soon as the new page is swapped in — still
	// hidden behind the fade-out/fade-in transition (see the frontmatter
	// above) — not once it's actually visible. Anything that's meant to be
	// the first thing the visitor sees (a hero letter reveal) should wait
	// for this instead, or it plays out mostly hidden during the fade and
	// is never actually seen running. The very first hard page load has no
	// transition to wait for, so it fires immediately. The data-page-ready
	// flag lets listeners registered after the event still catch it (see
	// scripts/page-ready.ts) — on that first load this handler can run
	// before a page's own astro:page-load handler has started listening.
	const pageTransitionMs = Number(document.documentElement.dataset.pageTransitionMs) || 0;
	let hasLoadedOnce = false;
	let pageReadyTimer = 0;
	function markPageReady() {
		document.documentElement.dataset.pageReady = "true";
		document.dispatchEvent(new CustomEvent("astro:page-ready"));
	}
	document.addEventListener("astro:page-load", () => {
		if (!hasLoadedOnce) {
			hasLoadedOnce = true;
			markPageReady();
			return;
		}
		pageReadyTimer = window.setTimeout(markPageReady, pageTransitionMs);
	});
	// A navigation that starts before the previous page's timer fired must
	// not let that stale timer mark the incoming page ready mid-fade.
	document.addEventListener("astro:before-swap", () => {
		clearTimeout(pageReadyTimer);
		delete document.documentElement.dataset.pageReady;
	});

	// Stop the browser from restoring the previous scroll position on
	// refresh/back-forward — every load/navigation should start at the top,
	// which the explicit scrollTo calls below enforce.
	if ("scrollRestoration" in history) {
		history.scrollRestoration = "manual";
	}

	// One instance for the whole session, not one per page. Locomotive's
	// default wrapper/content are window/document.documentElement, both of
	// which survive Astro's view transitions, so re-creating it on every
	// navigation would just reset the smoothing state and jump the scroll
	// position — calling .resize() after the new page's content is in the
	// DOM is enough to pick up the new scrollable height.
	let locomotiveScroll: LocomotiveScroll | null = null;

	// Runs as early as possible — right when the swap itself happens, still
	// during the old page's fade-out — so the reset has the whole rest of
	// the (now longer) transition to settle before the new page's fade-in
	// ever reveals it. If it ran only after astro:page-load instead, it'd be
	// racing the new page's very first visible frame.
	document.addEventListener("astro:before-swap", () => {
		window.scrollTo(0, 0);
		if (!locomotiveScroll) return;
		// If the user was still mid-scroll (wheel/touch momentum) the instant
		// they navigated, Lenis's own animation loop is still decaying that
		// velocity — scrollTo(0, {immediate:true}) alone doesn't cancel it,
		// so the old momentum keeps nudging the position afterwards instead
		// of it snapping. stop() resets Lenis's internal velocity/animation
		// state; start() resumes it — that sequence is what makes the jump
		// to top actually instant.
		const lenis = locomotiveScroll.lenisInstance;
		lenis?.stop();
		lenis?.start();
		locomotiveScroll.scrollTo(0, { immediate: true });
	});

	function initSmoothScroll() {
		if (locomotiveScroll) {
			// The jump to top already happened on astro:before-swap, above —
			// this just needs the new page's own scrollable height and
			// ScrollTrigger's trigger positions recalculated against it.
			locomotiveScroll.resize();
			ScrollTrigger.refresh();
			return;
		}

		// First hard load: no previous page to reset scroll on before a
		// swap, so it happens here instead — the browser already starts a
		// fresh load at the top on its own, but this covers a restored
		// scroll position (back/forward, bfcache) just in case.
		window.scrollTo(0, 0);

		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		locomotiveScroll = new LocomotiveScroll();

		// Without this, ScrollTrigger recalculates pin/scrub state on its own
		// ticker, one step out of phase with wherever Lenis has actually
		// smoothed the scroll to on a given frame — that mismatch is what
		// reads as an abrupt "snap" right as a pin engages. Driving
		// ScrollTrigger's updates directly off Lenis's own scroll event
		// keeps them in lockstep.
		locomotiveScroll.lenisInstance?.on("scroll", ScrollTrigger.update);
	}

	// Per-page scripts create their ScrollTriggers as soon as the DOM is
	// ready, which can be before async media (hero video, images) finishes
	// loading and settling layout below it. That leaves trigger start/end
	// pixel positions stale — a trigger further down the page fires at the
	// wrong scroll offset, or never during a normal scroll. Refreshing once
	// everything (including the video) has actually loaded recalculates
	// every trigger against the final layout.
	window.addEventListener("load", () => ScrollTrigger.refresh());

	// That single "load" refresh only covers what's already loading by the
	// time the page first settles. It misses anything that changes the
	// page's height afterwards: a `loading="lazy"` image (gallery, project
	// grid thumbnails) that only starts fetching once it nears the
	// viewport. Left uncorrected, every trigger below that element keeps the
	// stale position it was created with. Listening here, once, for the
	// whole session — instead of every page remembering to refresh after
	// its own async media — catches all of it, on every page, including
	// ones added after this listener was registered. `load`/`loadedmetadata`
	// don't bubble, but a capturing-phase listener on `document` still sees
	// them from any descendant.
	let mediaRefreshRaf = 0;
	function scheduleMediaRefresh() {
		if (mediaRefreshRaf) return;
		mediaRefreshRaf = requestAnimationFrame(() => {
			mediaRefreshRaf = 0;
			ScrollTrigger.refresh();
		});
	}
	function handleMediaSettle(event: Event) {
		if (event.target instanceof HTMLImageElement || event.target instanceof HTMLVideoElement) {
			scheduleMediaRefresh();
		}
	}
	document.addEventListener("load", handleMediaSettle, true);
	document.addEventListener("loadedmetadata", handleMediaSettle, true);
	document.fonts?.ready.then(() => scheduleMediaRefresh());

	document.addEventListener("astro:page-load", initSmoothScroll);

	// Letter-by-letter hover: each letter dims slightly, one after another,
	// and undims the same way on mouseleave. Used by .btn-primary (whose
	// underline fades via pure CSS, see main.css) and by the footer's text
	// links, which get the same letters effect without any underline.
	const LETTER_HOVER_SELECTOR = ".btn-primary, .site-footer .footer-col a:not(.brand)";

	function bindLetterHover() {
		document.querySelectorAll<HTMLElement>(LETTER_HOVER_SELECTOR).forEach((btn) => {
			if (btn.dataset.letterHoverBound) return;
			btn.dataset.letterHoverBound = "true";

			const letters = splitIntoLetterSpans(btn);

			btn.addEventListener("mouseenter", () => {
				gsap.to(letters, {
					opacity: 0.5,
					duration: 0.3,
					ease: "power2.out",
					stagger: 0.02,
				});
			});
			btn.addEventListener("mouseleave", () => {
				gsap.to(letters, {
					opacity: 1,
					duration: 0.3,
					ease: "power2.out",
					stagger: 0.02,
				});
			});
		});
	}

	document.addEventListener("astro:page-load", bindLetterHover);
</script>

<style>
	:root {
		/* fixed top banner strip; the hamburger + menu float above content */
		--header-total-height: 20px;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		font-family: var(--font-sans);
		color: var(--color-black);
		background: var(--color-offwhite);
	}

	main {
		flex: 1;
		padding-top: var(--header-total-height);
	}
</style>
