# Copy this file to .env and fill in real values. See .env for comments
# on where each value comes from.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
INQUIRY_TO_EMAIL=studio@flaviajackeline.com

# Cloudflare Turnstile (anti-spam on the inquiry form). Create a widget in
# the Cloudflare dashboard (Turnstile > Add widget, mode "Invisible") and
# paste its keys here. Blank = always-pass test keys (no bot protection).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
